<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="662.0" prefWidth="510.0" style="-fx-background-color: #7A9D96;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AssignRouteController">
    <children>
        <Button fx:id="backBtn" layoutX="35.0" layoutY="25.0" onAction="#handleBackToMenu" style="-fx-background-color: white;" text="Back" />
        <Text fx:id="assignRouteLbl" fill="WHITE" layoutX="136.0" layoutY="85.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Assign Route" textAlignment="CENTER">
            <font>
                <Font name="Arial Rounded MT Bold" size="37.0" />
            </font>
        </Text>
        <ComboBox fx:id="trainCmb" layoutX="55.0" layoutY="160.0" prefHeight="25.0" prefWidth="185.0" promptText="Train" />
        <Label fx:id="selectTrainLbl" layoutX="55.0" layoutY="130.0" text="Select Train:" textFill="white">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <ComboBox fx:id="stationCmb" layoutX="55.0" layoutY="245.0" prefHeight="25.0" prefWidth="403.0" promptText="Station" />
        <Label fx:id="selectStationLbl" layoutX="55.0" layoutY="215.0" text="Select Station:" textFill="white">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <ComboBox fx:id="cargoCmb" layoutX="293.0" layoutY="160.0" prefHeight="25.0" prefWidth="162.0" promptText="Cargo Mode" />
        <Label fx:id="selectCargoLbl" layoutX="293.0" layoutY="130.0" text="Select Cargo Mode:" textFill="white">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <ListView fx:id="stationList" layoutX="55.0" layoutY="305.0" prefHeight="326.0" prefWidth="238.0" />
        <Button fx:id="addStationBtn" layoutX="339.0" layoutY="358.0" onAction="#handleAddPointOfRoute" prefHeight="72.0" prefWidth="151.0" style="-fx-background-color: white;" text="Add Station to Route" />
        <Button fx:id="assignRouteBtn" layoutX="339.0" layoutY="491.0" onAction="#handleAssignRoute" prefHeight="72.0" prefWidth="151.0" style="-fx-background-color: white;" text="Assign Route to Train" />
    </children>
</AnchorPane>
