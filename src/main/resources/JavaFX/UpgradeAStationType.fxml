<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="540.0" prefWidth="509.0" style="-fx-background-color: #7A9D96;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ChangeStationTypeController">

   <children>

      <Button fx:id="backButton" layoutX="20.0" layoutY="31.0" onAction="#handleBackToMenu" style="-fx-background-color: white;" text="Back" />

      <Text fill="WHITE" layoutX="53.0" layoutY="103.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Upgrade a Station Type" textAlignment="CENTER">
         <font>
            <Font name="Arial Rounded MT Bold" size="37.0" />
         </font>
      </Text>

      <VBox layoutX="73.0" layoutY="129.0" prefWidth="362.0" spacing="10.0">

         <Label text="Select Station:" textFill="white" />
         <ComboBox fx:id="stationComboBox" onAction="#onStationSelected" prefHeight="26.0" prefWidth="405.0" />

         <Label fx:id="labelTest" textFill="white" />
         <ComboBox fx:id="stationTypeComboBox" prefHeight="26.0" prefWidth="405.0" />

         <Label fx:id="labelOrientation" text="Select Orientation:"
                textFill="white" visible="false"/>
         <ComboBox fx:id="orientationComboBox"
                   prefHeight="26.0" prefWidth="405.0"
                   visible="false"/>


         <Label text="Select Building:" textFill="white" />
         <Label fx:id="labelPriceDiff" textFill="white" />
         <Label fx:id="labelBudget" textFill="white" />

      </VBox>

      <Button layoutX="223.0" layoutY="334.0" onAction="#changeStationType" style="-fx-background-color: white;" text="Upgrade" />

   </children>
</AnchorPane>
