<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #7A9D96; -fx-pref-width: 509; -fx-pref-height: 540;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BuyLocomotiveController">
   <children>

      <Text fill="WHITE" layoutX="67.0" layoutY="121.0" strokeType="OUTSIDE" strokeWidth="0.0" text="BUY A LOCOMOTIVE" textAlignment="CENTER">
         <font>
            <Font name="Arial Rounded MT Bold" size="37.0" />
         </font>
      </Text>

      <Label fx:id="budgetLabel" layoutX="147.0" layoutY="422.0" prefHeight="18.0" prefWidth="216.0" text="CURRENT BUDGET: " textFill="WHITE">
         <font>
            <Font name="Arial Nova Light" size="14.0" />
         </font>
      </Label>

      <Text fill="WHITE" layoutX="66.0" layoutY="160.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Select a locomotive from the list below:">
         <font>
            <Font name="Arial Rounded MT Bold" size="14.0" />
         </font>
      </Text>

      <ComboBox fx:id="locomotiveComboBox" layoutX="62.0" layoutY="177.0" onAction="#updateLocomotiveInfo" prefHeight="26.0" prefWidth="385.0" visibleRowCount="5" />

      <Label fx:id="modelLabel" layoutX="62.0" layoutY="232.0" prefHeight="30.0" prefWidth="300.0" text="Locomotive Model: " textFill="WHITE">
         <font>
            <Font name="Arial Nova Cond" size="16.0" />
         </font>
      </Label>

      <Label fx:id="typeLabel" layoutX="62.0" layoutY="270.0" prefHeight="30.0" prefWidth="300.0" text="Type:" textFill="WHITE">
         <font>
            <Font name="Arial Nova Cond" size="16.0" />
         </font>
      </Label>

      <Label fx:id="topSpeedLabel" layoutX="62.0" layoutY="313.0" prefHeight="30.0" prefWidth="300.0" text="Top Speed:" textFill="WHITE">
         <font>
            <Font name="Arial Nova Cond" size="16.0" />
         </font>
      </Label>

      <Label fx:id="priceLabel" layoutX="62.0" layoutY="356.0" prefHeight="25.0" prefWidth="300.0" text="Price:" textFill="WHITE">
         <font>
            <Font name="Arial Nova Cond" size="16.0" />
         </font>
      </Label>

      <Button fx:id="buyButton" layoutX="224.0" layoutY="464.0" mnemonicParsing="false" onAction="#handleBuy" prefHeight="30.0" prefWidth="62.0" text="Buy" textAlignment="CENTER" />

      <Button fx:id="backButton" layoutX="14.0" layoutY="23.0" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="22.0" prefWidth="54.0" text="BACK">
         <font>
            <Font size="10.0" />
         </font>
      </Button>

   </children>
</AnchorPane>
