<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="540.0" prefWidth="510.0" style="-fx-background-color: #7A9D96;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddStationController">
   <children>
      <Button fx:id="backBtn" layoutX="30.0" layoutY="41.0" onAction="#handleBackToMenu" style="-fx-background-color: white;" text="Back" />
      <Text fx:id="addStationLbl" fill="WHITE" layoutX="150.0" layoutY="101.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Add Station" textAlignment="CENTER">
         <font>
            <Font name="Arial Rounded MT Bold" size="37.0" />
         </font>
      </Text>
      <ComboBox fx:id="stationTypeCmb" layoutX="48.0" layoutY="281.0" onAction="#handleTypeChange" prefHeight="25.0" prefWidth="179.0" promptText="Station Type" />
      <Label fx:id="selectTypeLbl" layoutX="48.0" layoutY="254.0" text="Select Station Type:" textFill="white">
         <font>
            <Font size="14.0" />
         </font></Label>
      <Label fx:id="mapLbl" layoutX="48.0" layoutY="135.0" text="Map:" textFill="white" />
      <Label fx:id="scenarioLbl" layoutX="48.0" layoutY="163.0" text="Scenario:" textFill="white" />
      <Label fx:id="budgetLbl" layoutX="48.0" layoutY="195.0" text="Budget:" textFill="white" />
      <ComboBox fx:id="orientationCmb" layoutX="284.0" layoutY="282.0" prefHeight="25.0" prefWidth="179.0" promptText="Station Orientation" />
      <Label fx:id="orientationLbl" layoutX="284.0" layoutY="255.0" text="Select Station Orientation:" textFill="white">
         <font>
            <Font size="14.0" />
         </font></Label>
      <Slider fx:id="XPosSli" layoutX="48.0" layoutY="361.0" prefHeight="14.0" prefWidth="179.0" />
      <Label fx:id="positionXLbl" layoutX="48.0" layoutY="337.0" text="X position" textFill="white" />
      <TextField fx:id="XPosTxt" layoutX="173.0" layoutY="333.0" onAction="#handleXPosTxt" prefHeight="25.0" prefWidth="54.0" promptText="X" />
      <Slider fx:id="YPosSli" layoutX="284.0" layoutY="359.0" prefHeight="14.0" prefWidth="179.0" />
      <Label fx:id="positionYLbl" layoutX="284.0" layoutY="335.0" text="Y position" textFill="white" />
      <TextField fx:id="YPosTxt" layoutX="409.0" layoutY="333.0" onAction="#handleYPosTxt" prefHeight="25.0" prefWidth="54.0" promptText="Y" />
      <Button fx:id="addBtn" layoutX="182.0" layoutY="466.0" onAction="#handleAddStation" prefHeight="43.0" prefWidth="146.0" style="-fx-background-color: white;" text="Add Station" />
      <Label fx:id="stationPriceLbl" alignment="CENTER" contentDisplay="CENTER" layoutX="48.0" layoutY="401.0" text="Station Price: 100" textAlignment="CENTER" textFill="white" textOverrun="CENTER_ELLIPSIS" wrapText="true">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
