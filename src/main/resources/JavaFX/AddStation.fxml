<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="527.0" style="-fx-background-color: #7A9D96;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddStationController">
   <children>
      <Button fx:id="backBtn" layoutX="14.0" layoutY="14.0" onAction="#handleBackToMenu" prefHeight="26.0" prefWidth="57.0" text="Back" />
      <Text fx:id="addStationLbl" fill="WHITE" layoutX="150.0" layoutY="75.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Add Station" textAlignment="CENTER">
         <font>
            <Font name="Arial Rounded MT Bold" size="37.0" />
         </font>
      </Text>
      <ComboBox fx:id="stationTypeCmb" layoutX="48.0" layoutY="256.0" onAction="#handleTypeChange" prefHeight="25.0" prefWidth="179.0" promptText="Station Type" />
      <Label fx:id="selectTypeLbl" layoutX="49.0" layoutY="227.0" text="Select Station Type:" textFill="white">
         <font>
            <Font name="Bell MT" size="14.0" />
         </font></Label>
      <Label fx:id="mapLbl" layoutX="48.0" layoutY="105.0" text="Map:" textFill="white">
         <font>
            <Font name="Bell MT" size="14.0" />
         </font></Label>
      <Label fx:id="scenarioLbl" layoutX="49.0" layoutY="134.0" text="Scenario:" textFill="white">
         <font>
            <Font name="Bell MT" size="14.0" />
         </font></Label>
      <Label fx:id="budgetLbl" layoutX="48.0" layoutY="161.0" text="Budget:" textFill="white">
         <font>
            <Font name="Bell MT" size="14.0" />
         </font></Label>
      <ComboBox fx:id="orientationCmb" layoutX="284.0" layoutY="256.0" prefHeight="25.0" prefWidth="179.0" promptText="Station Orientation" />
      <Label fx:id="orientationLbl" layoutX="284.0" layoutY="226.0" text="Select Station Orientation:" textFill="white">
         <font>
            <Font name="Bell MT" size="14.0" />
         </font></Label>
      <Label fx:id="positionXLbl" layoutX="51.0" layoutY="315.0" text="X Position" textFill="white">
         <font>
            <Font name="Bell MT" size="13.0" />
         </font></Label>
      <TextField fx:id="XPosTxt" layoutX="124.0" layoutY="311.0" onAction="#handleXPosTxt" prefHeight="26.0" prefWidth="103.0" promptText="X" />
      <Label fx:id="positionYLbl" layoutX="284.0" layoutY="315.0" text="Y Position" textFill="white">
         <font>
            <Font name="Bell MT" size="13.0" />
         </font></Label>
      <TextField fx:id="YPosTxt" layoutX="360.0" layoutY="311.0" onAction="#handleYPosTxt" prefHeight="26.0" prefWidth="103.0" promptText="Y" />
      <Button fx:id="addBtn" layoutX="182.0" layoutY="466.0" onAction="#handleAddStation" prefHeight="43.0" prefWidth="146.0" text="Add Station">
         <font>
            <Font size="16.0" />
         </font></Button>
      <Label fx:id="stationPriceLbl" alignment="CENTER" contentDisplay="CENTER" layoutX="169.0" layoutY="400.0" prefHeight="35.0" prefWidth="172.0" text="Station Price: 100" textFill="#f70000" textOverrun="CENTER_ELLIPSIS" wrapText="true">
         <font>
            <Font name="Bell MT" size="20.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
