<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="456.0" prefWidth="444.0" style="-fx-background-color: #7A9D96; -fx-text-fill: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ChooseScenarioController">

   <children>

      <Text fill="WHITE" layoutX="132.0" layoutY="61.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome!" textAlignment="CENTER">
         <font>
            <Font name="Arial Rounded MT Bold" size="37.0" />
         </font>
      </Text>

      <Text fill="WHITE" layoutX="51.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Choose a scenario from the list below:">
         <font>
            <Font name="Arial Rounded MT Bold" size="14.0" />
         </font>
      </Text>

      <ComboBox fx:id="scenarioComboBox" layoutX="51.0" layoutY="140.0" prefHeight="26.0" prefWidth="336.0" onAction="#updateScenarioInfo" />

      <Label fx:id="mapLabel" layoutX="51.0" layoutY="180.0" text="Map: " textFill="WHITE">
         <font>
            <Font name="Arial Nova Cond" size="13.0" />
         </font></Label>
      <Label fx:id="yearLabel" layoutX="51.0" layoutY="210.0" text="Year: " textFill="WHITE">
         <font>
            <Font name="Arial Nova Cond" size="13.0" />
         </font></Label>
      <Label fx:id="budgetLabel" layoutX="51.0" layoutY="240.0" text="Budget: " textFill="WHITE">
         <font>
            <Font name="Arial Nova Cond" size="13.0" />
         </font></Label>

      <Button layoutX="51.0" layoutY="280.0" onAction="#handleContinue" text="Continue" />

      <VBox fx:id="menuBox" layoutX="51.0" layoutY="320.0" prefHeight="120.0" prefWidth="336.0" spacing="10.0" />

   </children>
</AnchorPane>
