@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
    - name
    - ID
    - password
}

class Train {
    - name
    - ID
    - date of purchase
}

class Locomotive {
    - name
    - locomotiveType
    - power
    - acceleration
    - topSpeed
    - startYear
    - acquisitionType
}

class Carriage {
    - name
    - ID
}

Player "1" --> "1..*" Train : lists
Train "1" --> "1" Locomotive : has
Train "1" --> "*" Carriage : has

@enduml