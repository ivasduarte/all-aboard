@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : asks to add a station
    activate System
    deactivate Player

    System --> Player : requests data (station type)
    deactivate System
    activate Player

    Player -> System : types requested data
    activate System
    deactivate Player

    System --> Player : shows all data and displays operation success
    deactivate System
    activate Player

@enduml