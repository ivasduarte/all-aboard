@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Map {
    - name
    - width
    - height
}

class RailwayLine {
    - name
    - id
    - selected stations
    - length
    - type
}

class Player {
    - name
    - ID
    - password
}

class Station {
    - name
    - id
    - type
    - building
}

class Building {
    - id
    - type
}

Map "1" - "*" RailwayLine : has
Player "1" -- "*" RailwayLine : build
RailwayLine "2" - "*" Station : connects
Station "1" - "*" Building : is

@enduml