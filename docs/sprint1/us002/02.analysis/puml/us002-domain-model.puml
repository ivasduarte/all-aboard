@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Map {
    - name
    - width
    - height
}

class Industry {
    - position XY on the map
    - name
    - id
}

class Editor {
    - name
    - ID
}

class IndustryType {
    - name
    - id
    - description
}

Map "1" - "*" Industry : has
Editor "1" -- "*" Industry : creates
Industry "1" - "*" IndustryType : has

@enduml