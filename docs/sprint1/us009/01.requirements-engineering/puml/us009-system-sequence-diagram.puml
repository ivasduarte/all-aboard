@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

Player -> System : Request to buy a train
activate System
deactivate Player

System --> Player : Display list of available locomotives
deactivate System
activate Player

loop Selecting locomotives
    Player -> System : Selects a locomotive
    activate System
    deactivate Player

    System --> Player : Ask if they want to add another locomotive
    deactivate System
    activate Player

    alt Player adds another locomotive
        Player -> System : Selects another locomotive
        activate System
    else Player finalizes selection
        System --> Player : Confirms selection
        deactivate System
    end
end

activate System
System -> Player : Show purchase details (selected locomotives\n and current date)
deactivate System

@enduml
