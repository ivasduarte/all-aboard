@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : asks to assign a route
    activate System
    deactivate Editor

    System --> Editor : requests data (train, station, route)
    deactivate System
    activate Editor

    Editor -> System : types requested data
    activate System
    deactivate Editor

    System --> Editor : shows all data and displays operation success
    deactivate System
    activate Editor

@enduml