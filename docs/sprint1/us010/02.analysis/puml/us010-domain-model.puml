@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class RailwayLine{
    - id
    - name
    - size
}

class Train{
    - name
    - ID
    - date of purchase
}

class Station {
    - id
    - name
    - type
    - building
    - cargoDemand
    - cargoSupply
}

class Player {
    - id
    - name
    - password
}

Player "1" - "1" Train : selects
Player "1" -- "1" Station : selects

Player "1" -- "1" RailwayLine : assigns
@enduml