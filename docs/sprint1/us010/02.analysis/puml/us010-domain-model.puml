@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Map {
    - id
    - name
    - size
}

class Railway{
    - id
    - name
    - size
}

class Train{
    - name
    - locomotiveType
    - power
    - acceleration
    - topSpeed
    - startYear
    - acquisitionType
}

class Station {
    - id
    - name
    - type
    - building
    - cargoDemand
    - cargoSupply
}

class Player {
    - id
    - name
    - password
}

Player "1" - "1" Train : selects
Player "1" -- "1" Station : selects

Map "1" - "*" Railway : has
Player "1" -- "1" Railway : assigns
@enduml