@startuml "domain-model"

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

hide circle
hide methods

class Editor{
- name
    - ID
    - password
}

class Player{
- name
    - ID
    - password
}

class Simulation{
}

class Map{
- name
- width
- height
}

class City{
- position XY
    - name
    - number of house blocks
}

class Industry{
 - position XY on the map
    - name
    - id
}

class Scenario{
   - timeRestrictions
  - technologicalRestrictions
  - historicalRestrictions
}

class Station{
    - id
        - name
        - type
        - building
}

class Building{
    - id
    - type
}

class Cargo{
}

class RailwayLine{
- name
    - id
    - selected stations
    - length
    - type
}


class Train{
- name
    - ID
    - date of purchase
}

class Locomotive{
- name
    - locomotiveType
    - power
    - acceleration
    - topSpeed
    - startYear
    - acquisitionType
}

class LocomotiveType{
    - name
    - ID
    - description
}

class Carriage{
- name
    - cargoType
}
class CargoType{
    - name
    - ID
}


Editor -- Map : creates >
Editor -- Scenario : creates >
Map *-- "0..*" City : contains >
Map *-- "0..*" Industry : contains >
Scenario -- Map : uses >

Station o-- "0..*" Building : has >


RailwayLine -- "2" Station : connects >

Player -- Station : builds >
Player -- RailwayLine : builds >
Player -- Train : buys >

Simulation -- Player: creates >
Simulation -- Editor: creates >

Train *-- "1" Locomotive : has >
Locomotive "1" - "*" LocomotiveType : has
Carriage "1" - "*" CargoType : has
Train *-- "0..*" Carriage : has >
Train -- Route : assigned to >
'should this be included? the route?
Route *-- "2..*" Station : includes >

City -- "0..*" Cargo : generates/consumes >
Industry -- "0..*" Cargo : generates/processes >



@enduml