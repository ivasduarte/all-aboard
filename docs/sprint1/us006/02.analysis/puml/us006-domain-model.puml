@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
  - name: String
}

class Station {
  - id: int
  - name: String
  - buildings: List<Building>
}

class Building {
  - id: int
  - type: String
}

Player "1" --> "1..*" Station : upgrades
Station "1" --> "*" Building : contains

@enduml