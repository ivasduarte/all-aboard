@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
    - name
    - ID
    - password
}

class Station {
    - id
    - name
    - type
    - building
}

class Building {
    - id
    - type
}

Player "1" --> "1..*" Station : upgrades
Station "1" --> "*" Building : contains

@enduml