@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : asks to add a building
    activate System
    deactivate Player

    System --> Player : requests data (name of the station\nname of the building)
    deactivate System
    activate Player

    Player -> System : types requested data
    activate System
    deactivate Player

    System --> Player : shows all data and displays operation success or operation failure
    deactivate System
    activate Player

@enduml