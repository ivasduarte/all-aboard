@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false


skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
  - name: String
}

class Station {
  - id: int
  - name: String
  - buildings: List<Building>
  - cargoSupply: List<Cargo>
  - cargoDemand: List<Cargo>
}

Player "1" --> "1..*" Station : lists
Station "1" --> "*" Building : contains
Station "1" --> "*" Cargo : manages

@enduml