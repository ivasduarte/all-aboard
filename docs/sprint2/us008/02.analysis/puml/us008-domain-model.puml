@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Map {
    - name
    - width
    - height
}

class RailwayLine {
    - name
    - id
    - selected stations
    - length
    - type
}

class RailwayLineType {
    - name
    - id
}

class Player {
    - name
    - password
}

class Station {
    - name
    - id
    - type
    - building
}

class Building {
    - id
    - type
}

Map "1" - "*" RailwayLine : has
Player "1" -- "*" RailwayLine : build
RailwayLine "*" - "2" Station : connects
Station "1" - "*" Building : is
RailwayLine "*" -- "1" RailwayLineType : has

@enduml