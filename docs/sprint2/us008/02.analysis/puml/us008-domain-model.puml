@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Map {
    - name
    - width: int
    - height: int
}

class Scenario {
    - name
    - timeRestrictions
    - technologicalRestrictions
    - historicalRestrictions
}

class City {
    - name
    - position
    - houseBlocks
}

class Player {
    - name
    - password
}

class RailwayLine {
    - name
    - id
    - length
    - type
}

class RailwayLineType {
    - name
    - id
}

class Station {
    - name
    - id
    - position
    - type
    - center
}

Map "1" -- "1" Scenario : defines
Scenario "1" -- "*" City : contains
City "1" - "*" Station : has
RailwayLine "1" -- "2" Station : connects
RailwayLine "*" - "1" RailwayLineType : has
Player "1" -- "*" RailwayLine : builds

@enduml