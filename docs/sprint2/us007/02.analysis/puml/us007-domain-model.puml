@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false


skinparam classAttributeIconSize 0

hide circle
hide methods

class Map {
    - name
    - width: int
    - height: int
}

class Scenario {
    - name
    - timeRestrictions
    - technologicalRestrictions
    - historicalRestrictions
}

class City {
    - name
    - position
    - houseBlocks
}

class Player {
    - name
    - ID
    - password
}

class Station {
    - id
    - name
    - type
    - building
    - cargoDemand
    - cargoSupply
}

class Building {
    - id
    - type
}

class Cargo {
    - id
    - type
}

Map "1" -- "1" Scenario : defines
Scenario "1" -- "*" City : contains
City "1" - "*" Station : has
Player "1" --> "1 *" Station : lists
Station "1" --> "*" Building : contains
Station "1" --> "*" Cargo : manages

@enduml