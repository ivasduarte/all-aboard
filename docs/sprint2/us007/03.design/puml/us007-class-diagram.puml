@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0


class ListStationsUI {
    + displayStationsList()
    + selectStationToViewDetails()
}

class ListStationsController {
    + listAllStations() : List<Station>
    + getStationDetails(stationId: String) : StationDetails
}


class Repositories {
    + getStationRepository() : StationRepository
    + getBuildingRepository() : BuildingRepository
    + getCargoService() : CargoService
}

class StationRepository {
    - List<Station> stations
    + getAllStations() : List<Station>
    + findById(id: String) : Station
}

class BuildingRepository {
    + getBuildingsForStation(stationId: String) : List<Building>
}


class Station {
    - String id
    - String name
    - String type
    - double x
    - double y
    + getName() : String
    + getType() : StationType

}


class Building {
    - String name
    - BuildingType type
    + getName()
    + getType()
}

class CargoService {
    + getCargoSummary(station: Station) : CargoSummary
}

class CargoSummary {
    - int supply
    - int demand
    + getSupply()
    + getDemand()
}


ListStationsUI .> ListStationsController : uses
ListStationsController ..> Repositories : accesses
Repositories --> StationRepository
Repositories --> BuildingRepository
Repositories --> CargoService

ListStationsController ..> StationRepository : uses
ListStationsController ..> CargoService : gets summary
ListStationsController ..> BuildingRepository : fetches buildings


StationDetails --> Station
StationDetails --> CargoSummary
StationDetails --> "0..*" Building



@enduml
