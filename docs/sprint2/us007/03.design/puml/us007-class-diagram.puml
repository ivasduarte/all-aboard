@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class ListStationsUI {
    - map: Map
    + run(): void
    + getInput(): void
}

class ListStationsController {
    - stationRepository: StationRepository
    + getStationsByMapName(mapName: String): List<Station>
}

class StationRepository {
    - stations: List<Station>
    + getAvailableStationsByMapName(mapName: String): List<Station>
    + getStations(): List<Station>
}

class Station {
    - stationID: int
    - stationType: String
    - positionX: int
    - positionY: int
    - buildings: List<Building>
    - map: Map
    + getStationID(): int
    + getStationType(): String
    + getPositionX(): int
    + getPositionY(): int
    + getBuildings(): List<Building>
    + getCargo(): int
    + getMap(): Map
}

class Building {
    - buildingType: String
    + getBuildingType(): String
}

class Map {
    - mapName: String
    + getMapName(): String
}

ListStationsUI ..> ListStationsController
ListStationsController ..> StationRepository
Station --> "0..*" Building
Station --> Map
@enduml
