@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "ListStationsUI" as UI

activate Player

Player -> UI : start the simulation
activate UI

UI --> Player : shows a list of the available maps
Player -> UI : selects a map
UI --> Player : shows a list of the available scenarios
Player -> UI : selects a scenario
UI --> Player : shows a list of the cities
Player -> UI : selects a city
UI --> Player : shows a list of the actions the player can do
Player -> UI : selects to list all stations

create "ListStationsController" as CTRL
UI -> CTRL : new()
deactivate UI
activate CTRL

CTRL -> Repositories : getInstance()
activate Repositories
Repositories --> CTRL : RepositorySingleton
deactivate Repositories

CTRL -> RepositorySingleton : getStationRepository()
activate RepositorySingleton
RepositorySingleton --> CTRL : StationRepository
deactivate RepositorySingleton

participant "StationRepository" as Station_REPO
CTRL -> Station_REPO : getAllStations()
activate Station_REPO
Station_REPO --> CTRL : list of stations
deactivate Station_REPO

participant "CargoService" as CargoService
loop for each station
    CTRL -> CargoService : getCargoSummary(station)
    activate CargoService
    CargoService --> CTRL : CargoSummary (available & demanded)
    deactivate CargoService
end loop

CTRL -> CTRL : sortStationsByName()

CTRL --> UI : list of stations with summaries
deactivate CTRL
activate UI

UI --> Player : displays list of stations
deactivate UI

@enduml
