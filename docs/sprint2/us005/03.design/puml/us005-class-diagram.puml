@startuml
skinparam packageeStyle rectangle
skinparam shadowing false
skinparam linetype polyline

skinparam classAttributeIconSize 0

class Player {
    - String name
    - String ID
    - String password
    + getPlayerName()
    + getPlayerID()
    + getPlayerPassword()
}

class UserSession {
}

class ApplicationSession {
    + static getInstance()
    + getCurrentSession()
}


class Station {
    - String name
    - String stationType
    - String id
    + getStationType()
    + getStationName()
}

class Building {
    - String buildingType
    + Building(buildingType)
    + getBuildingType()
}

class AddAStationUI {
}

class AddAStationController {
    + getAddRepository()
    + AddStation(stationToBeAdded)
    + getStationList()
}

class Repositories {
    - Repositories()
    + getInstance() : repositories
    + getAddRepository()
}

class AddRepository {
    - Station
    + addStation(stationToBeAdded)
}

Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

AddAStationUI .> AddAStationController

AddAStationController .> Repositories : repositories

Repositories -> "1" AddRepository
AddAStationController ..> Station
AddAStationController ..> Building
AddAStationController ..> AddRepository

ApplicationSession --> "1" UserSession : userSession

AddAStationController ..> ApplicationSession
AddAStationController ..> UserSession

AddRepository "1" --> "*" Station : stations

Station --> Player : createdBy
Station --> "*" Building : buildings

@enduml
