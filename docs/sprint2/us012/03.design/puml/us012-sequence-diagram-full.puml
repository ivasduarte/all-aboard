@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Editor
participant "SimulatorUI" as UI

activate Editor

Editor -> UI : start the project
activate UI

UI --> Editor : shows a list of the available maps
Editor -> UI : selects a map
UI --> Editor : shows a list of the available scenarios
Editor -> UI : selects a scenario
UI --> Editor : creates the simulator


create "SimulatorController" as CTRL
UI --> CTRL : create

participant "Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT

UI --> Editor : shows the option to start simulation
Editor -> UI : starts simulation


UI --> CTRL : StartSimulation(scenario)
activate CTRL

CTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton
RepositorySingleton --> CTRL : repositories
deactivate RepositorySingleton

CTRL -> PLAT : getCreateSimulatorRepository()
activate PLAT
PLAT --> CTRL : CreateSimulatorRepository
deactivate PLAT

CTRL -> CreateSimulatorRepository : StartSimulation(scenario)
activate CreateSimulatorRepository

create "CreateSimulatorRepository\n:CreateSimulatorRepository" as CreateSimulatorRepository
create "Simulator" as Simulator
CreateSimulatorRepository -> Simulator : create()
CreateSimulatorRepository -> CreateSimulatorRepository : StartSimulation(scenario)

CreateSimulatorRepository --> CTRL : CreateSimulatorData
deactivate CreateSimulatorRepository

CTRL --> UI : CreateSimulatorData
deactivate CTRL

UI --> Editor : displays operation success and AddData
deactivate UI

@enduml