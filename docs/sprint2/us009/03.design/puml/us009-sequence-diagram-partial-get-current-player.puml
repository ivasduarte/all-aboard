@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false


participant ":BuyLocomotiveController" as CTRL
participant ":Repositories" as reps
participant "repositories\n:Repositories" as PLAT
participant "locomotiveRepo\n:LocomotiveRepository" as LocomotiveRepo
participant ":ApplicationSession" as AppSession
participant ":UserSession" as UserSession

autonumber 1

--> CTRL**: create
activate CTRL
CTRL -> reps : getInstance()
activate reps
reps --> CTRL : repositories
deactivate reps

CTRL -> PLAT : getLocomotiveRepository()
activate PLAT
PLAT --> CTRL : locomotiveRepository
deactivate PLAT

CTRL -> AppSession : getInstance()
activate AppSession
AppSession --> CTRL : applicationSession
deactivate AppSession

CTRL -> AppSession : getCurrentSession()
activate AppSession
AppSession --> CTRL : userSession
deactivate AppSession

CTRL -> UserSession : getCurrentPlayer()
activate UserSession
UserSession --> CTRL : player
deactivate UserSession

@enduml