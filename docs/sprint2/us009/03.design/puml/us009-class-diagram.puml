@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

'title: Class diagram for Buy a Train (US009)

class ApplicationSession {
    + static getInstance()
    + getCurrentSession()
}

class UserSession {
}

class Player {
    - String name
    - String ID
    - String password
}

class Train {
    - String name
    - String ID
    - Date dateOfPurchase
    + getTrainName()
    + getDateOfPurchase()
}

class Locomotive {
    - String serialNumber
    - LocomotiveType locomotiveType
    - int power
    - int acceleration
    - int topSpeed
    - int startYear
    - String acquisitionType
}

enum LocomotiveType {
    Steam
    Diesel
    Electricity
}

class Carriage {
    - String id
    - CargoType cargoType
}

enum CargoType {
    Passengers
    Mail
    Coal
    IronOre
    Steel
    Cars
}

class TrainRepository {
    - List<Train> trains
    + getTrainsList()
    + saveTrain(train: Train)
}

class Repositories {
    - Repositories()
    + getInstance(): Repositories
    + getTrainRepository(): TrainRepository
}

class BuyTrainController {
    + buyTrainWithLocomotiveAndCarriages()
    + getTrainList()
    + getTrainRepository()
}

class BuyTrainUI {
}


BuyTrainUI .> BuyTrainController
BuyTrainController .> Repositories : accesses
BuyTrainController ..> TrainRepository : uses
BuyTrainController ..> Train : creates
BuyTrainController ..> Locomotive : selects
BuyTrainController ..> Carriage : optionally adds

ApplicationSession -> ApplicationSession : instance
ApplicationSession --> "1" UserSession : userSession
BuyTrainController ..> ApplicationSession
BuyTrainController ..> UserSession

Repositories -> "1" TrainRepository


Train "1" --> "1" Locomotive : locomotive
Train "1" -- "*" Carriage : has
Player "1" -- "*" Train : creates

Locomotive "1" -- "1" LocomotiveType
Carriage "1" -- "1" CargoType

Train --> Player : createdBy

note bottom of TrainRepository
    Holds and manages train objects
end note

@enduml
