@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

'title: Class diagram for Buy a Locomotive (US009)

class ApplicationSession {
    + static getInstance()
    + getCurrentSession()
}

class UserSession {
    + getCurrentPlayer(): Player
}

class Player {
    - String name
    - String ID
    - String password
    - double budget
    + getBudget(): double
    + updateBudget(double amount)
}

class Locomotive {
    - String serialNumber
    - LocomotiveType locomotiveType
    - int power
    - int acceleration
    - int topSpeed
    - int startYear
    - double acquisitionPrice
    - double fuelCostPerYear
    - double maintenanceCostPerYear
    - String acquisitionType
    - Date dateOfPurchase
    + getSerialNumber(): String
    + getLocomotiveType(): LocomotiveType
    + getAcquisitionPrice(): double
    + getDateOfPurchase(): Date
}

enum LocomotiveType {
    STEAM
    DIESEL
    ELECTRIC
}

class LocomotiveRepository {
    - List<Locomotive> locomotives
    + getLocomotiveList(): List<Locomotive>
    + getLocomotiveBySerialNumber(String serialNumber): Locomotive
    + saveLocomotive(Locomotive locomotive)
}

class Repositories {
    - Repositories()
    + getInstance(): Repositories
    + getLocomotiveRepository(): LocomotiveRepository
}

class Scenario {
    - String name
    - List<LocomotiveType> availableLocomotiveTypes
    - Date startDate
    - Date endDate
    + getAvailableLocomotiveTypes(): List<LocomotiveType>
    + isLocomotiveTypeAvailable(LocomotiveType type): boolean
}

class BuyLocomotiveController {
    + getAvailableLocomotives(Date currentDate): List<Locomotive>
    + buyLocomotive(String serialNumber): boolean
    - checkPlayerBudget(double price): boolean
}

class BuyLocomotiveUI {
}

BuyLocomotiveUI ..> BuyLocomotiveController
BuyLocomotiveController ..> Repositories : accesses
BuyLocomotiveController ..> LocomotiveRepository : uses
BuyLocomotiveController ..> Locomotive : selects
BuyLocomotiveController ..> ApplicationSession : gets current session
BuyLocomotiveController ..> Player : gets and updates budget

ApplicationSession -> ApplicationSession : instance
ApplicationSession --> "1" UserSession : userSession

Repositories -> Repositories : instance
Repositories --> "1" LocomotiveRepository : locomotiveRepository

Player "1" -- "*" Locomotive : purchases >
Locomotive "1" -- "1" LocomotiveType : type

note bottom of LocomotiveRepository
    Manages available locomotives
end note

note right of Scenario
    Contains locomotive type restrictions 
    for the current game scenario
end note

@enduml
