@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Train{
    - name
    - date of purchase
}
class Locomotive {
    - name
    - serialNumber
    - locomotiveType
    - power
    - acceleration
    - topSpeed
    - startYear
    - acquisitionType
}

enum LocomotiveType{
    - Steam
    - Diesel
    - Electricity
}

class Carriage{
    - name
    - cargoType
}

enum CargoType{
    - Passengers
    - Mail
    - Coal
    - Iron ore
    - Steel
    - Cars
}

class Player {
    - name
    - ID
    - password
}

Train "1" - "*" Locomotive : has
Player "1" -- "*" Train : creates
Locomotive "1" - "*" LocomotiveType : has
Carriage "1" - "*" CargoType : has
Train "1" - "*" Carriage : has

@enduml