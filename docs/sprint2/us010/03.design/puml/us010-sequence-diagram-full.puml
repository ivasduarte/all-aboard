@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Editor
participant "AssignARouteUI" as UI

activate Editor

Editor -> UI : start the simulation
activate UI

UI --> Editor : shows a list of the available maps
Editor -> UI : selects a map
UI --> Editor : shows a list of the available scenarios
Editor -> UI : selects a scenario
UI --> Editor : shows a list of the cities
Editor -> UI : selects a city
UI --> Editor : shows a list of the railroads
Editor -> UI : selects a railroads


create "AssignARouteController" as CTRL
UI --> CTRL : create

participant "Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT

UI --> Editor : shows a list of the available trains
Editor -> UI : selects a train to assign to a route
UI --> Editor : assign the selected train to the route


UI --> CTRL : AssignRoute(train, route)
activate CTRL

CTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton
RepositorySingleton --> CTRL : repositories
deactivate RepositorySingleton

CTRL -> PLAT : getBuildAssignRepository()
activate PLAT
PLAT --> CTRL : BuildAssignRepository
deactivate PLAT

CTRL -> BuildAssignRepository : BuildAssign(train, route)
activate BuildAssignRepository

create "BuildAssignRepository\n:BuildAssignRepository" as BuildAssignRepository
BuildAssignRepository -> BuildAssign : create()
BuildAssignRepository -> BuildAssignRepository : AssignRoute(train, route)

BuildAssignRepository --> CTRL : BuildAssignData
deactivate BuildAssignRepository

CTRL --> UI : BuildAssignData
deactivate CTRL

UI --> Editor : displays operation success and AddData
deactivate UI

@enduml