@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : asks to assign a route
    activate System

    System --> Player : requests data (train, station, route)
    deactivate System

    Player -> System : types requested data
    activate System

    System --> Player : shows all data and displays operation success
    deactivate System

@enduml