@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class ApplicationSession{
    + static getInstance()
    + getCurrentSession()
}

class UserSession{
}

class HRM {
}

class City {
    - String name
    + City(name)
}



class skillRepository {
    - List <City>
    + getCityList()
}


class Repositories {
    - Repositories()
    + getInstance() : repositories
    + getCityRepository()

}

class RegisterCityController{
    + registerCity(skillRepository)
    + getJCityList()
    + getCityRepository
}

note right of RegisterCityController
    - skillName
    is achieved with skill repository
end note

note bottom of skillRepository
    - used for displaying
    the skill list
end note

class RegisterCityUI {
}

Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

RegisterCityUI .> RegisterCityController

RegisterCityController .> Repositories : repositories

Repositories -> "1" skillRepository
RegisterCityController ..> City
RegisterCityController ..> skillRepository : skillRepository


ApplicationSession --> "1" UserSession : userSession

RegisterCityController ..> ApplicationSession
RegisterCityController ..> UserSession

skillRepository "1" --> "*" City : Citys

City--> HRM : createdBy

skillRepository --> "*" HRM : employs

@enduml