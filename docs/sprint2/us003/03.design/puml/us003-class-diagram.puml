@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class ApplicationSession{
    + static getInstance()
    + getCurrentSession()
}

class UserSession{
}

class Editor {
    - String name
    - String ID
    - String password
}

class City {
    - String name
    - int posX
    - int posY
    - int numHouseBlocks
    + City(name, posX, posY, numHouseBlocks)
    + getCityName()
    + getCityPositionX()
    + getCityPositionY()
    + getCityNumHouseBlocks()
}



class cityRepository {
    - List <City>
    + getCitiesList()
}


class Repositories {
    - Repositories()
    + getInstance() : repositories
    + getCityRepository()

}

class AddCityController{
    + addCity(cityRepository)
    + getCityList()
    + getCityRepository
}

note right of AddCityController
    - cityName
    is achieved with city repository
end note

note bottom of cityRepository
    - used for displaying
    the cities list
end note

class AddCityUI {
}

Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

AddCityUI .> AddCityController

AddCityController .> Repositories : repositories

Repositories -> "1" cityRepository
AddCityController ..> City
AddCityController ..> cityRepository : cityRepository


ApplicationSession --> "1" UserSession : userSession

AddCityController ..> ApplicationSession
AddCityController ..> UserSession

cityRepository "1" --> "*" City : Cities

City--> Editor : createdBy


@enduml