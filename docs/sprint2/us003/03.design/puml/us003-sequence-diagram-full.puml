@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox
actor "Editor" as Editor
participant ":AddCityUI" as UI
participant ":AddCityController" as CTRL
participant ":Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT
participant "cityRepository:\nCityRepository" as cityRepository
participant "City:\nCity" as City


activate Editor

        Editor -> UI : asks to add a new city

        activate UI
            UI -> CTRL** : create

         UI -> Editor : requests data(city name)
         Editor -> UI : types requested data (city name)
         UI -> Editor : requests data(position XY in the map)
         Editor -> UI : types requested data (position XY in the map)
        UI -> Editor : requests data(number of house blocks)
         Editor -> UI : types requested data (number of house blocks)

            UI -> CTRL : addCity(city name, position XY in the map, number of house blocks)

            activate CTRL
            CTRL -> CTRL : verifyCity(city name, position XY in the map, number of house blocks))


                CTRL -> RepositorySingleton : getInstance()
                activate RepositorySingleton

                    RepositorySingleton --> CTRL: repositories
                deactivate RepositorySingleton

                CTRL -> PLAT : getCityRepository()
                activate PLAT

                    PLAT --> CTRL: cityRepository
                deactivate PLAT


                activate cityRepository


                    CTRL -> cityRepository : addCity (city name, position XY in the map, number of house blocks)

                    cityRepository -> City** : create()


                    cityRepository -> cityRepository : verifyIfExistAndSave(city name, position XY in the map, number of house blocks)




                cityRepository -> CTRL : cityData


                CTRL --> UI : cityData
            deactivate CTRL


            UI --> Editor : displays operation success and \n show cityData
    deactivate UI

deactivate Editor

@enduml