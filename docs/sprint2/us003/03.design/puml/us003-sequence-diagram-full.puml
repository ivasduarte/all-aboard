@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox
actor "Editor" as Editor
participant ":AddCityUI" as UI
participant ":AddCityController" as CTRL
participant ":Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT
participant "cityRepository:\nCityRepository" as cityRepository
participant "City:\nCity" as City


activate Editor

        Editor -> UI : asks to add a new city

        activate UI
            UI -> CTRL** : create

        UI -> Editor: requests to select the map
        Editor -> UI: selects the map
         UI -> Editor : requests data(city name, position X, position Y, number of house blocks)
         Editor -> UI : types requested data (city name, position X, position Y, number of house blocks)
            UI -> CTRL : addCity(mapID, city name, position X, position Y, number of house blocks)

            activate CTRL



                CTRL -> RepositorySingleton : getInstance()
                activate RepositorySingleton

                    RepositorySingleton --> CTRL: repositories
                deactivate RepositorySingleton

                CTRL -> PLAT : getCityRepository()
                activate PLAT

                    PLAT --> CTRL: cityRepository
                deactivate PLAT


                activate cityRepository


                    CTRL -> cityRepository : addCity (mapID, city name, position X, position Y, number of house blocks)

                    cityRepository -> City** : create()


                    cityRepository -> cityRepository : verifyIfExistsAndSave(mapID, city name, position X, position Y, number of house blocks)




                cityRepository -> CTRL : cityData


                CTRL --> UI : cityData
            deactivate CTRL


            UI --> Editor : displays operation success and \n show cityData
    deactivate UI

deactivate Editor

@enduml