@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber


actor "Editor" as Editor
participant ":AddCityUI" as UI
participant ":AddCityController" as CTRL
participant ":Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT
participant "cityRepository\n:CityRepository" as cityRepository
participant ":City" as City


activate Editor

Editor -> UI : asks to add a new city

activate UI
UI -> CTRL** : create

UI -> Editor: requests to select the map
Editor -> UI: selects the map
UI -> Editor : requests data(cityName, positionX, positionY, houseBlocks)
Editor -> UI : types requested data (cityName, positionX, positionY, houseBlocks)
UI -> CTRL : submitData(mapID, cityName, positionX, positionY, houseBlocks)

activate CTRL

CTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton

RepositorySingleton --> CTRL: repositories
deactivate RepositorySingleton

CTRL -> PLAT : getCityRepository()
activate PLAT

PLAT --> CTRL: cityRepository
deactivate PLAT

CTRL -> cityRepository : addCity (mapID, city name, position X,\nposition Y, number of house blocks)
activate cityRepository

cityRepository -> City : create(mapID, cityName,\npositionX, positionY, houseBlocks)
activate City

City --> cityRepository : isSuccessful
deactivate City

cityRepository --> CTRL : isSuccessful
deactivate cityRepository

CTRL --> UI : isSuccessful
deactivate CTRL

UI --> Editor : display result
deactivate UI
deactivate Editor

@enduml