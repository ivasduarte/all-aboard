@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {
    - name
    - ID
    - password
}

class Station {
    - id
    - name
    - type
    - building
    - cargoDemand
    - cargoSupply
}

class Cargo{
    - id
    - type
}

class Building {
    - id
    - type
}

Player "1" --> "1..*" Station : upgrades
Station "1" --> "*" Building : contains
Station "1  " --> "*" Cargo: contains

@enduml