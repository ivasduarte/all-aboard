@startuml
skinparam monochrome true
autonumber

participant "UpgradeAStationController" as CTRL
participant "StationUpgradeService" as Service
participant "Building" as Building
participant "Station" as Station

activate CTRL

CTRL -> Building : create(type)

CTRL -> Service : upgradeStation(station, building, year)
activate Service

Service -> Station : getBuildings()
activate Station
Station --> Service : List<Building>
deactivate Station

Service -> Service : checkMutualExclusivity(existingBuildings, newType)

Service -> Station : addBuilding(building)
activate Station

alt success
    Station --> Service : true
    Service --> CTRL : true
else failure
    Station --> Service : false
    Service --> CTRL : false
end

deactivate Station
deactivate Service
deactivate CTRL
@enduml
