@startuml
skinparam monochrome true
autonumber

participant "StationUpgradeService" as Service
participant "Station" as Station

activate Service
Service -> Station : addBuilding(building)
activate Station

alt building == null
    Station --> Service : throw IllegalArgumentException
else max buildings reached
    Station --> Service : return false
else duplicate building type
    Station --> Service : return false
else success
    Station --> Service : return true
end

deactivate Station
deactivate Service
@enduml
