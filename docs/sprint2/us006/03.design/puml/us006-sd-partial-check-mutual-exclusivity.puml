@startuml
skinparam monochrome true
autonumber

participant "UpgradeAStationController" as Controller
participant "StationUpgradeService" as Service

activate Controller
Controller -> Service : checkMutualExclusivity(existingBuildings, newType)
activate Service

alt Not allowed together
    Service --> Controller : return false
else Allowed
    Service --> Controller : return true
end

deactivate Service
deactivate Controller
@enduml
