@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Editor
participant "UpgradeAStationUI" as UI

activate Editor

Editor -> UI : start the simulation
activate UI

UI --> Editor : shows a list of the available maps
Editor -> UI : selects a map
UI --> Editor : shows a list of the available scenarios
Editor -> UI : selects a scenario
UI --> Editor : shows a list of the cities
Editor -> UI : selects a city
UI --> Editor : shows a list of the actions the player can do
Editor -> UI : selects to upgrade a station

create "UpgradeAStationController" as CTRL
UI --> CTRL : create

participant "Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT

UI --> Editor : shows a list of the available stations
Editor -> UI : selects the station
UI --> Editor : requests the type of the building
Editor -> UI : inserts the type of the building


UI --> CTRL : UpgradeAStation(station to be upgraded, type of the building)
activate CTRL

CTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton
RepositorySingleton --> CTRL : repositories
deactivate RepositorySingleton

CTRL -> PLAT : getBuildUpgradeRepository()
activate PLAT
PLAT --> CTRL : BuildUpgradeRepository
deactivate PLAT

CTRL -> BuildUpgradeRepository : BuildUpgrade(station to be upgraded, type of the building)
activate BuildUpgradeRepository

create "BuildUpgradeRepository\n:BuildUpgradeRepository" as BuildUpgradeRepository
BuildUpgradeRepository -> BuildUpgrade : create()
BuildUpgradeRepository -> BuildUpgradeRepository : verifyIfExistsAndSave(station, type of building)

BuildUpgradeRepository --> CTRL : BuildUpgradeData
deactivate BuildUpgradeRepository

CTRL --> UI : BuildUpgradeData
deactivate CTRL

UI --> Editor : displays operation success and upgradeData
deactivate UI

@enduml