@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "UpgradeAStationUI" as UI
participant "UpgradeAStationController" as CTRL
participant "Repositories" as Repos
participant "StationRepository" as Station_REPO
participant "BuildingRepository" as Building_REPO
participant "StationUpgradeService" as UpgradeService

activate Player

Player -> UI : start the simulation
activate UI

UI --> Player : shows a list of the available maps
Player -> UI : selects a map
UI --> Player : shows a list of the available scenarios
Player -> UI : selects a scenario
UI --> Player : shows a list of the cities
Player -> UI : selects a city
UI --> Player : shows a list of the actions the player can do
Player -> UI : selects to upgrade a station

UI -> CTRL : create controller
activate CTRL

CTRL -> Repos : getInstance()
Repos --> CTRL : Repositories instance

CTRL -> Repos : getStationRepository()
Repos --> CTRL : StationRepository

CTRL -> Station_REPO : getAvailableStations()
activate Station_REPO
Station_REPO --> CTRL : List<AvailableStation>
deactivate Station_REPO

CTRL --> UI : Send Stations
deactivate CTRL

UI --> Player : shows a list of the available stations
Player -> UI : selects the station
UI -> CTRL : Check buildings available
activate CTRL

CTRL -> Repos : getBuildingRepository()
Repos --> CTRL : BuildingRepository

CTRL -> Building_REPO : getAvailableBuildings(station, currentDate)
activate Building_REPO
Building_REPO --> CTRL : AvailableBuildings
deactivate Building_REPO

CTRL --> UI : Send Available Buildings
deactivate CTRL

UI --> Player : shows list of existing + available buildings
UI --> Player : requests the type of the building to add
Player -> UI : inserts the type of the building
UI -> CTRL : upgradeStation(station, buildingType)
activate CTRL

CTRL -> UpgradeService : verifyIfExistsAndSave(station, buildingType)
activate UpgradeService
UpgradeService -> UpgradeService : validateDate(buildingType, currentDate)
UpgradeService -> UpgradeService : replaceObsoleteBuilding(station, buildingType)
UpgradeService -> UpgradeService : checkMutualExclusivity(station, buildingType)

alt Building not valid or already exists
    UpgradeService --> CTRL : Error Detected
    CTRL --> UI : show error message
    UI --> Player : display error
else Success
    UpgradeService --> CTRL : BuildUpgradeData
    CTRL --> UI : show success message
    UI --> Player : display success
end

deactivate UpgradeService
deactivate CTRL
deactivate UI

@enduml
