@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant "UpgradeAStationUI" as UI
participant "UpgradeAStationController" as CTRL
participant "Repositories" as Repos
participant "StationRepository" as Station_REPO
participant "StationUpgradeService" as Station_UPG
participant "Station" as Station
participant "Building" as Building

Player -> UI : run()
activate UI

UI -> CTRL : new UpgradeAStationController()
activate CTRL

CTRL -> Repos : getInstance()
Repos --> CTRL : Repositories instance

CTRL -> Repos : getStationRepository()
Repos --> CTRL : StationRepository

CTRL -> Station_REPO : getAvailableStations()
Station_REPO --> CTRL : List<Station>
CTRL --> UI : List<Station>

UI -> Player : display list of stations
Player -> UI : selects station
UI -> Player : prompt for building type
Player -> UI : inputs building type

UI -> CTRL : upgradeStation(station, buildingType, currentYear)

CTRL -> Building : new Building(buildingType)
activate Building
Building --> CTRL : return Building instance
deactivate Building

CTRL -> Station_UPG : upgradeStation(station, building, year)
activate Station_UPG

Station_UPG -> Station_UPG : validateData(buildingType, year)
Station_UPG -> Station_UPG : checkMutualExclusivity(existingBuildings, buildingType)
Station_UPG -> Station_UPG : handleReplacement(existingBuildings, buildingType)
Station_UPG -> Station : addBuilding(building, year)

alt Validation failed or no slot available
    Station --> Station_UPG : false
    Station_UPG --> CTRL : false
    CTRL --> UI : display error
    UI --> Player : show error message
else Upgrade successful
    Station --> Station_UPG : true
    Station_UPG --> CTRL : true
    CTRL --> UI : display success
    UI --> Player : show success message
end

deactivate Station_UPG
deactivate CTRL
deactivate UI
@enduml
