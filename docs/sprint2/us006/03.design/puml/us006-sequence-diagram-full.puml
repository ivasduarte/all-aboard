@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Editor
participant "UpgradeAStationUI" as UI
participant "UpgradeAStationController" as CTRL

activate Editor

Editor -> UI : start the simulation
activate UI

UI --> Editor : shows a list of the available maps
Editor -> UI : selects a map
UI --> Editor : shows a list of the available scenarios
Editor -> UI : selects a scenario
UI --> Editor : shows a list of the cities
Editor -> UI : selects a city
UI --> Editor : shows a list of the actions the player can do
Editor -> UI : selects to upgrade a station


UI -> CTRL : new()
deactivate UI
activate CTRL

CTRL -> Repositories : getInstance()
activate Repositories

Repositories --> CTRL : RepositorySingleton
deactivate Repositories

CTRL -> RepositorySingleton : getStationRepository()
activate RepositorySingleton

RepositorySingleton --> CTRL : StationRepository
deactivate RepositorySingleton

participant "StationRepository" as Station_REPO

CTRL -> Station_REPO : getAvailableStations()
activate Station_REPO

Station_REPO --> CTRL : List<AvailableStation>
deactivate Station_REPO

CTRL --> UI : Send Stations

deactivate CTRL
activate UI

UI --> Editor : shows a list of the available stations
Editor -> UI : selects the station
UI -> CTRL : Check buildings available
deactivate UI

activate CTRL

CTRL -> Repositories : getBuildingRepository()
activate Repositories

Repositories --> CTRL : BuildingRepository
deactivate Repositories

participant "BuildingRepository" as Station_BUILD
activate Station_BUILD
CTRL -> Station_BUILD : getAvailableBuildings()
Station_BUILD --> CTRL : AvailableBuildings
deactivate Station_BUILD
CTRL --> UI: Send Available Buildings
deactivate CTRL

activate UI
UI --> Editor : shows a list of existing buildings in the station and those who are available to build.
UI --> Editor : requests the type of the building
Editor -> UI : inserts the type of the building
UI -> CTRL : Upgrade a Station
deactivate UI

participant "BuildUpgradeRepository" as Station_UPG
activate CTRL
CTRL -> Station_UPG : BuildUpgrade(station to be upgraded, type of the building)
activate Station_UPG

Station_UPG -> BuildUpgrade : create()
Station_UPG -> Station_UPG : verifyIfExistsAndSave(station, type of building)
Station_UPG --> CTRL : BuildUpgradeData
deactivate Station_UPG

CTRL --> UI : BuildUpgradeData
deactivate CTRL
activate UI

UI --> Editor : displays operation success and upgradeData
deactivate UI

@enduml