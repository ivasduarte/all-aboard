@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

class Station {
  - mapID: int
  - positionX: int
  - positionY: int
  - stationID: int
  - stationType: String
  - buildings: List<Building>
  + Station(mapID: int, posX: int, posY: int, stationType: String)
  + isAvailable(): boolean
  + getMap(): Map
  + getBuildings(): List<Building>
  + getStationType(): String
  + getStationID(): int
  + getPositionX(): int
  + getPositionY(): int
}

class Building {
  - buildingType: String
  + getBuildingType(): String
}

class ListStationsController {
  - StationRepo: StationRepository
  + getStationsByMapName(mapName: String): List<Station>
}

class ListStationsUI <<boundary>> {
  - map: Map
  + run(): void
  + getInput(): void
}

class StationRepository {
  - stations: List<Station>
  + getAvailableStationsByMapName(mapName: String): List<Station>
  + getStations(): List<Station>
}

class Repositories <<singleton>> {
  - instance: Repositories
  - stationRepo: StationRepository
  + getInstance(): Repositories
  + getStationRepository(): StationRepository
}

ListStationsUI ..> ListStationsController
ListStationsController ..> StationRepository
Repositories ..> StationRepository
Station "1" --> "0..*" Building

@enduml
