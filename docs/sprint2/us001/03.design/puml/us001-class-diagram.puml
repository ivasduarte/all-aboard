@startuml
skinparam classAttributeIconSize 0

class CreateMapUI {
    -controller: CreateMapController
    -message: String
    -map: Map
    +getInput(): void
    +MapCreationResult(message, map)
    +showSuccess(): void
    +showError(): void
}

class CreateMapController {
    +createMap(name, width, height): CreateMapUI.MapCreationResult
}

class MapRepository {
    -maps: List <Map>
    +getMapList()
    +save(map): void
    +existsByName(): boolean
}

class Editor {
    -name: String
    -ID: String
    -password: String
    +Editor(name, id, password)
    +getName()
    +getID()
    +getPassword()
}

class Map {
    -name: String
    -width: int
    -height: int
    +Map(name, width, height)
    +getMapName(): String
    +validateName(): void
    +validateSize(): void
}


class Repositories {
    -instance: Repositories{static}
    -mapRepository: MapRepository
    +Repositories()
    +getInstance(): repositories
    +getMapRepository()
}

class ApplicationSession {
    -instance: ApplicationSession{static}
    -userSession: UserSession
    +getInstance(): static
    +getCurrentSession()
    +setUserSession()
}

class UserSession {}

Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

CreateMapUI .> CreateMapController
CreateMapController .> Repositories : repositories

Repositories -> "1" MapRepository
CreateMapController ..> Map
CreateMapController ..> MapRepository : mapRepository

ApplicationSession --> "1" UserSession : userSession

CreateMapController ..> ApplicationSession
CreateMapController ..> UserSession

mapRepository "1" --> "*" Map

Map --> Editor : createdBy

@enduml