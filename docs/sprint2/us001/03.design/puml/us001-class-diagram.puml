@startuml
skinparam classAttributeIconSize 0

class CreateMapUI {
    +getInput()
    +showSuccess()
    +showError()
}

class CreateMapController {
    +createMap(mapRepository)
}

class MapRepository {
    -List <Map>
    +getMapList()
    +validateName()
    +validateSize()
    +save(map)
}

class Editor {
    -name: String
    -ID: String
    -password: String
    +getEditorName()
    +getEditorID()
    +getEditorPassword()
}

class Map {
    -name: String
    -width: int
    -height: int
    +Map(name, width, height)
    +getMapName()
}


class Repositories {
    -Repositories()
    +getInstance() : repositories
    +getMapRepository()
}

class ApplicationSession {
    +getInstance() : static
    +getCurrentSession()
}

class UserSession {}

Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

CreateMapUI .> CreateMapController
CreateMapController .> Repositories : repositories

Repositories -> "1" MapRepository
CreateMapController ..> Map
CreateMapController ..> MapRepository : mapRepository

ApplicationSession --> "1" UserSession : userSession

CreateMapController ..> ApplicationSession
CreateMapController ..> UserSession

mapRepository "1" --> "*" Map

Map --> Editor : createdBy

@enduml