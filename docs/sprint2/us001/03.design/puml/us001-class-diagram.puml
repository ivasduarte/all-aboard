@startuml
skinparam classAttributeIconSize 0

class Map {
    -name: String
    -width: int
    -height: int
    +Map(name, width, height)
    +getMapName(): String
    +getWidth(): int
    +getHeight(): int
    +validateName(): void
    +validateSize(): void
    +toString(): String
}

interface Runnable <<interface>>{
    +run(): void
}

class CreateMapUI {
    -controller: CreateMapController
    -mapRepository: MapRepository
    -mapName: String
    -width: int
    -height: int
    +getController(): CreateMapController
    +getMapRepository(): MapRepository
    +run(): void
    +getInput(): void
    +requestMapName(): String
    +requestWidth(): int
    +requestHeight(): int
    +submitData(): void
}

class CreateMapController {
    +createMap(name, width, height): Map
}

class MapRepository {
    -maps: List <Map>
    +add(map: Map): void
    +validateMap(map: Map): boolean
    +existsByName(name: String): boolean
    +getMapList(): List<Map>
    +getMap(name: String): Optional<Map>
}

class Editor {
    -name: String
    -ID: String
    -password: String
    +Editor(name, id, password)
    +getEditorName(): String
    +getPassword(): String
    +getID(): String
}

class Repositories {
    -instance: Repositories{static}
    -mapRepository: MapRepository
    +Repositories()
    +getInstance(): Repositories
    +getMapRepository(): MapRepository
}

class ApplicationSession {
    -instance: ApplicationSession{static}
    -userSession: UserSession
    +getInstance(): ApplicationSession{static}
    +getCurrentSession(): UserSession
    +setUserSession(): void
}

class UserSession {
    -instance: UserSession{static}
    -user: UserSession
    +getInstance(): UserSession{static}
}

Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

CreateMapUI ..|> Runnable
CreateMapUI .> CreateMapController
CreateMapController ..> Map
CreateMapController ..> ApplicationSession
CreateMapController ..> UserSession
CreateMapController ..> MapRepository : mapRepository

Repositories --> "1" MapRepository

ApplicationSession --> "1" UserSession : userSession
Map --> Editor : createdBy

mapRepository "1" --> "*" Map

@enduml