@startuml

class Editor {
    +createMap(name, width, height)
}

class Map {
    -name: String
    -width: int
    -height: int
    +validateName()
    +validateSize()
}

class MapRepository {
    +isNameUnique(name)
    +save(map)
}

class CreateMapUI {
    +getInput()
    +showSuccess()
    +showError()
}

class CreateMapController {
    +createMap(name, width, height)
}

class UserSession {
    +getCurrentUser(): Editor
}

Editor --> Map : creates >
CreateMapController --> Map : creates >
CreateMapController --> MapRepository : uses
CreateMapController --> UserSession : uses
CreateMapController --> Editor : gets current user
CreateMapUI --> CreateMapController : interacts
UserSession --> Editor : returns

@enduml