@startuml
skinparam classAttributeIconSize 0

class CreateMapUI {
    +getInput()
    +showSuccess()
    +showError()
}

class CreateMapController {
    +createMap(name, width, height)
}

class MapRepository {
    +save(map)
}

class Editor {
    +createMap(name, width, height)
}

class Map {
    -name: String
    -width: int
    -height: int
    +validateName()
    +validateSize()
}

class ApplicationSession

class UserSession {
    +getCurrentUser(): Editor
}

CreateMapUI --> CreateMapController
CreateMapController --> UserSession
CreateMapController --> MapRepository
CreateMapController --> Editor
Editor --> Map
Map --> MapRepository

UserSession --> ApplicationSession

@enduml