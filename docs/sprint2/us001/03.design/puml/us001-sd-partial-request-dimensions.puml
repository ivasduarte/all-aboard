@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber 16

actor Editor
participant ":CreateMapUI" as UI
participant ":CreateMapController" as ctrl

activate Editor
activate UI

group Request Map Dimensions
    UI -> Editor : requestWidth()
    deactivate UI

    Editor --> UI : provides width
    activate UI

    UI -> Editor : requestHeight()
    deactivate UI

    Editor --> UI : provides height
    activate UI
end

UI -> ctrl : submitData()
@enduml