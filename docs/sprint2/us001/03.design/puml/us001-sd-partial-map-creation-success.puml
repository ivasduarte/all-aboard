@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber 25

actor Editor
participant ":CreateMapUI" as UI
participant ":CreateMapController" as ctrl
participant "mapRepository\n:MapRepositories" as repo

activate Editor
activate ctrl
activate UI
ctrl -> repo : add(map)
activate repo

group Map Creation Success
    repo -> repo : validateMap(map)
    repo --> ctrl : void
    deactivate repo

    ctrl --> UI : map
    deactivate ctrl

    UI --> Editor : "Map (name) successfully created!"
    deactivate UI
end
@enduml