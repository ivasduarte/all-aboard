@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
actor "Editor" as Editor
participant ":CreateMapUI" as UI
participant ":CreateMapController" as CTRL
participant ":UserSession" as US
participant ":Editor" as EditorDom
participant ":MapRepository" as Repo
participant "Map" as Map

activate Editor

Editor -> UI : requests to create a map

activate UI
UI -> CTRL : create()

UI -> Editor : prompt for name and dimensions
Editor -> UI : provides name and dimensions
UI -> CTRL : submit(name, width, height)

activate CTRL

CTRL -> US : getCurrentUser()
US --> CTRL : user

CTRL -> Repo : checkNameUniqueness(name)
Repo --> CTRL : isUnique

CTRL -> EditorDom : createMap(name, width, height)
activate EditorDom
EditorDom -> Map : new(name, width, height)
Map --> EditorDom : mapInstance
deactivate EditorDom

CTRL -> Repo : save(mapInstance)
Repo --> CTRL : success

CTRL --> UI : operation result (success/failure)
UI --> Editor : display result

deactivate CTRL
deactivate UI
deactivate Editor

@enduml