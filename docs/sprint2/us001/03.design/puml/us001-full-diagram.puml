@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
actor "Editor" as Editor
participant ":CreateMapUI" as UI
participant ":CreateMapController" as CTRL
participant ":Repositories" as reps
participant "repositories\n:Repositories" as PLAT
participant "mapRepository\n:MapRepository" as Repo
participant ":Map" as Map

activate Editor

Editor -> UI : requests to create a map

activate UI
UI -> CTRL** : create

UI -> Editor : prompt for name and dimensions
Editor -> UI : provides name and dimensions
UI -> CTRL : submit(name, width, height)

activate CTRL

CTRL -> reps : getInstance()
activate reps

reps --> CTRL : repositories
deactivate reps

CTRL -> PLAT : getMapRepository()
activate PLAT

PLAT --> CTRL: mapRepository
deactivate PLAT

CTRL -> Repo : checkNameUniqueness(name)
activate Repo

Repo --> CTRL : isUnique
CTRL -> Repo : createMap(name, width, height)

Repo -> Map : createVerifyMap(name, width, height)
activate Map

Map --> Repo: isSuccessful
deactivate Map

Repo --> CTRL : isSuccessful
deactivate Repo

CTRL --> UI : isSucessful
deactivate CTRL

UI --> Editor : display result
deactivate UI
deactivate Editor

@enduml