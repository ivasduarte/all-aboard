@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateMapController" as ctrl
participant "Repositories" as Reps
participant "repositories\n:Repositories" as reps
participant "mapRepository\n:MapRepository" as repo

autonumber 9


group Get Map Object
    autonumber 10
    activate ctrl
    ctrl -> Reps : getInstance()
    activate Reps
    Reps --> ctrl : repositories
    deactivate Reps

    ctrl -> reps: getMapRepository()
    activate reps
    reps --> ctrl : mapRepository
    deactivate reps

    ctrl -> repo : getMap()
    activate repo
    repo --> ctrl : map
    deactivate repo
end

@enduml