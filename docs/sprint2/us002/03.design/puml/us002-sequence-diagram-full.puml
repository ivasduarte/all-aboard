@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":AddIndustryUI" as UI

activate Editor

Editor -> UI : asks to add an industry
activate UI

create ":AddIndustryController" as CTRL
UI -> CTRL : create()

participant ":Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT
participant "industryRepository\n:IndustryRepository" as industryRepository

UI --> Editor : shows a list of the available maps
deactivate UI

Editor -> UI : selects a map from the list
activate UI

UI --> Editor : shows a list of the available scenarios
deactivate UI

Editor -> UI : selects a scenario from the list
activate UI

UI --> Editor : asks to introduce the position the map will take place
deactivate UI

Editor -> UI : introduces the respective position
activate UI

UI --> Editor : shows a list of the available types of industries
deactivate UI

Editor -> UI : selects a type of industry
activate UI

UI -> CTRL : submitData(mapId, scenarioId, positionX, positionY, industryType)
activate CTRL

CTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton

RepositorySingleton --> CTRL : repositories
deactivate RepositorySingleton

CTRL -> PLAT : getIndustryRepository()
activate PLAT

PLAT --> CTRL : industryRepository
deactivate PLAT

CTRL -> industryRepository : addIndustry(mapId, scenarioId, positionX, positionY, industryType)
activate industryRepository

create "industry\n:Industry" as industry
industryRepository -> industry : create()

industryRepository -> industryRepository : verifyIfExistsAndSave(mapId, scenarioId, positionX, positionY, industryType)

industryRepository --> CTRL : industryData
deactivate industryRepository

CTRL --> UI : industryData
deactivate UI

UI --> Editor : shows success message
deactivate Editor

deactivate Editor

@enduml