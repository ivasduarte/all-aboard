@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":AddIndustryUI" as UI
participant ":AddIndustryController" as CTRL
participant ":Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT
participant "industryRepository\n:IndustryRepository" as industryRepository
participant "industry\n:Industry" as Industry

activate Editor

Editor -> UI : asks to add an industry
activate UI

UI -> CTRL : create

UI --> Editor : shows a list of the available maps
Editor -> UI : selects the map

UI --> Editor : shows a list of the available scenarios
Editor -> UI : selects the scenario

UI --> Editor : requests the position XY
Editor -> UI : inserts the position

UI --> Editor : shows a list of the type of industries available
Editor -> UI : selects the type of industry

UI -> CTRL : addIndustry(mapID, scenarioID, position XY, type of industry)
activate CTRL

CTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton
RepositorySingleton --> CTRL : repositories
deactivate RepositorySingleton

CTRL -> PLAT : getIndustryRepository()
activate PLAT
PLAT --> CTRL : industryRepository
deactivate PLAT

activate industryRepository
CTRL -> industryRepository : addIndustry(mapID, scenarioID, position XY, type of industry)

industryRepository -> Industry : create()

industryRepository -> industryRepository : verifyIfExistsAndSave(mapID, scenarioID, position XY, type of industry)

industryRepository --> CTRL : industryData
CTRL --> UI : industryData
deactivate CTRL

UI --> Editor : displays operation success and industryData
deactivate UI

deactivate Editor

@enduml