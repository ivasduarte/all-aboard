@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
actor "Editor" as Editor
participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as CTRL
participant ":UserSession" as US
participant ":ScenarioRepository" as Repo
participant ":Editor" as EditorDom
participant "Scenario" as Scenario
participant "Map" as Map

activate Editor

Editor -> UI : starts creating a scenario

activate UI
UI -> CTRL : create()

UI -> Editor : prompts for scenario data (name, restrictions, map)
Editor -> UI : provides data
UI -> CTRL : submit(name, restrictions, selectedMap)

activate CTRL

CTRL -> US : getCurrentUser()
US --> CTRL : user

CTRL -> Repo : checkScenarioNameUniqueness(name)
Repo --> CTRL : isUnique

CTRL -> EditorDom : createScenario(name, restrictions, selectedMap)
activate EditorDom
EditorDom -> Scenario : new(name, restrictions, selectedMap)
Scenario --> EditorDom : scenarioInstance
deactivate EditorDom

CTRL -> Repo : save(scenarioInstance)
Repo --> CTRL : success

CTRL --> UI : operation result (success/failure)
UI --> Editor : show success or error

deactivate CTRL
deactivate UI
deactivate Editor

@enduml