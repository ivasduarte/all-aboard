@startuml
actor Editor
participant CreateScenarioUI
participant CreateScenarioController
participant UserSession
participant Editor
participant Scenario
participant ScenarioRepository
participant MapRepository

== Step 1: UI collects scenario data ==
Editor -> CreateScenarioUI : enter scenario name, restrictions,\nand select map

== Step 2: UI delegates request to controller ==
CreateScenarioUI -> CreateScenarioController : createScenario(name, restrictions,\nmapId)

== Step 3: Controller gets current user ==
CreateScenarioController -> UserSession : getCurrentUser()
UserSession --> CreateScenarioController : Editor

== Step 4: Validate mandatory map selection ==
CreateScenarioController -> MapRepository : exists(mapId)
MapRepository --> CreateScenarioController : true/false

alt if Map NOT selected
    CreateScenarioController -> CreateScenarioUI : showError("Must select a map for scenario")
else if Map selected
    == Step 5: Validate scenario data locally ==
    CreateScenarioController -> Scenario : new(name, restrictions, mapId)
    Scenario -> Scenario : validateName()
    Scenario -> Scenario : validateRestrictions()

    == Step 6: Global validation for uniqueness ==
    CreateScenarioController -> ScenarioRepository : isNameUnique(name)
    ScenarioRepository --> CreateScenarioController : true/false

    alt if validation fails (invalid restrictions or\nduplicate/invalid name)
        CreateScenarioController -> CreateScenarioUI : showError("Invalid name,\nrestrictions, or duplicate scenario")
    else if validation succeeds
        == Step 7: Create scenario ==
        CreateScenarioController -> Editor : createScenario(name, restrictions, mapId)
        Editor -> ScenarioRepository : save(scenario)
        == Step 8: Success feedback ==
        CreateScenarioController -> CreateScenarioUI : showSuccess("Scenario created successfully")
    end
end
@enduml