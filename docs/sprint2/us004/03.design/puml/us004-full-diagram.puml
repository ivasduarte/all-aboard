@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
actor "Editor" as Editor
participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as CTRL
participant ":Repositories" as reps
participant "repositories\n:Repositories" as PLAT
participant "scenarioRepository\n:ScenarioRepository" as Repo
participant "Scenario" as Scenario

activate Editor

Editor -> UI : starts creating a scenario

activate UI
UI -> CTRL** : create

UI -> Editor : prompts for scenario data (name, restrictions, map)
Editor -> UI : provides data
UI -> CTRL : submit(name, restrictions, selectedMap)

activate CTRL

CTRL -> reps : getInstance()
activate reps

reps --> CTRL : repositories
deactivate reps

CTRL -> PLAT : getScenarioRepository()
activate PLAT

PLAT --> CTRL : scenarioRepository
deactivate PLAT

CTRL -> Repo : checkNameUniqueness(name)
activate Repo

Repo --> CTRL : isUnique
CTRL -> Repo : createScenario(name, restrictions, map)

Repo -> Scenario : createVerifyScenario(name, restrictions, map)
activate Scenario

Scenario --> Repo :isSuccessful
deactivate Scenario

Repo --> CTRL : isSuccessful
deactivate Repo

CTRL --> UI : isSuccessful
deactivate CTRL

UI --> Editor : display result
deactivate UI
deactivate Editor

@enduml