@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as CTRL
participant ":Repositories" as reps
participant "scenarioRepository\n:ScenarioRepository" as Repo

activate UI
activate CTRL

group Check Name Uniqueness
    loop while scenarioName already exists
        autonumber 7
        CTRL -> Repo : existsByName(name)
        autonumber 7.1
        Repo --> CTRL : true
        CTRL -> UI : showError()
        autonumber 8
        UI --> CTRL : new scenarioName
    end

    CTRL -> Repo : existsByName(name)
    Repo --> CTRL : false
    deactivate CTRL
end

@enduml