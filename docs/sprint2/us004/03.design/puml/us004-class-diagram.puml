@startuml
skinparam classAttributeIconSize 0

class CreateScenarioUI {
  +getInput(): void
  +showSuccess(message: String): void
  +showError(message: String): void
}

class CreateScenarioController {
  +createScenario(name: String, restrictions:\nRestrictions, mapId: int): void
}

class ScenarioRepository {
    -List <Scenario>
    +getScenarioList()

    +save(scenario: Scenario): void
}

class Editor {
    -name: String
    -ID: String
    -password: String
    +getEditorName(): void
    +getEditorID(): void
    +getEditorPassword(): void
    +createScenario(name: String, restrictions:\nRestrictions, map: Map): Scenario
}

class Scenario {
  -name: String
  -restrictions: Restrictions
  -map: Map

  +validateName(): void
  +validateRestrictions(): void
}

class Map {
    -name: String
    -width: int
    -height: int
    +Map(name, width, height)
    +getMapName()
    +validateName()
    +validateSize()
}

class Repositories {
    -Repositories()
    +getInstance() : repositories
    +getScenarioRepository()
}

class ApplicationSession {
    +getInstance() : static
    +getCurrentSession()
}

class UserSession {}


Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

CreateScenarioUI .> CreateScenarioController
CreateScenarioController .> Repositories : repositories

Repositories -> "1" ScenarioRepository
CreateScenarioController ..> Scenario
CreateScenarioController ..> ScenarioRepository : scenarioRepository

ApplicationSession --> "1" UserSession : userSession

CreateScenarioController ..> ApplicationSession
CreateScenarioController ..> UserSession

scenarioRepository "1" --> "*" Scenario
Scenario o-- Map : uses

Map --> Editor : createdBy
@enduml