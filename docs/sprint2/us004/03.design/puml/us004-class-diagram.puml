@startuml
skinparam classAttributeIconSize 0

class Scenario {
    -name: String
    -restrictions: Restrictions
    -map: Map
    +Scenario(name: String, restrictions: Restrictions, map: Map)
    +getScenarioName(): String
    +getRestrictions(): Restrictions
    +getMap(): Map
    +validateName(): boolean
    +validateRestrictions(): boolean
    +hasValidMap(): boolean
    +isValid(): boolean
    +toString(): String
}

interface Runnable <<interface>>{
    +run(): void
}

class CreateScenarioUI {
    -ctrl: CreateScenarioController
    -scenarioName: String
    -restrictions: Restrictions
    +getInput(): void
    +run(): void
    +submitData(): void
    +showError(message: String): void
    +showSuccess(message: String): void
}

class CreateScenarioController {
    -scenarioRepository: ScenarioRepository
    +createScenario(name: String, restrictions: Restrictions, map: Map): String
    +getScenarioList(): List<Scenario>
}

class ScenarioRepository {
    -scenarios: List<Scenarios>
    +ScenarioRepository()
    +add(scenario: Scenario): void
    +validateScenario(scenario: Scenario): boolean
    +existsByName(name: String): boolean
    +getScenarioList(): List<Scenario>
}

class Editor {
    -name: String
    -ID: String
    -password: String
    +Editor(name: String, ID: String, password: String)
    +getEditorName(): String
    +getPassword(): String
    +getID(): String
    +createScenario(name: String, restrictions: Restrictions, map: Map): Scenario
}


class Map {
    -name: String
    -width: int
    -height: int
    +Map(name, width, height)
    +getMapName(): String
    +getWidth(): int
    +getHeight(): int
    +validateName(): void
    +validateSize(): void
    +toString(): String
}

class Repositories {
    -instance: Repositories{static}
    -scenarioRepository: ScenarioRepository
    +Repositories()
    +getInstance(): Repositories{static}
    +getScenarioRepository(): ScenarioRepository
}

class ApplicationSession {
    -instance: ApplicationSession{static}
    -userSession: UserSession
    +ApplicationSession()
    +getInstance(): ApplicationSession{static}
}

class UserSession {
    -instance: UserSession{static}
    -user: UserSession
    +UserSession()
    +getInstance(): UserSession{static}
}


Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

CreateScenarioController ..|> Runnable
CreateScenarioUI .> CreateScenarioController
CreateScenarioController .> Repositories : repositories

Repositories -> "1" ScenarioRepository
CreateScenarioController ..> Scenario
CreateScenarioController ..> ScenarioRepository : scenarioRepository

ApplicationSession --> "1" UserSession : userSession

CreateScenarioController ..> ApplicationSession
CreateScenarioController ..> UserSession

scenarioRepository "1" --> "*" Scenario
Scenario o-- Map : uses

Map --> Editor : createdBy
@enduml