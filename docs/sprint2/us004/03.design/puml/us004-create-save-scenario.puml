@startuml
Editor -> EditorController : createScenario()
EditorController -> UserSession : getCurrentUser()
activate UserSession

deactivate UserSession
EditorController -> ScenarioController : createScenario()
activate ScenarioController

ScenarioController -> ScenarioValidator : validateScenarioData()
activate ScenarioValidator

deactivate ScenarioValidator
ScenarioController -> ScenarioRepository : saveScenario()

activate ScenarioRepository
deactivate ScenarioRepository
deactivate ScenarioController
@enduml