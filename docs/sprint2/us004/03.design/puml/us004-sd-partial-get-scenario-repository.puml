@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateScenarioController" as CTRL
participant ":Repositories" as reps
participant "repositories\n:Repositories" as PLAT
participant "scenarioRepository\n:ScenarioRepository" as Repo

autonumber 6.1

activate CTRL

group Get Scenario Repository
    CTRL -> reps : getInstance()
    activate reps
    reps --> CTRL : repositories
    deactivate reps

    CTRL -> PLAT : getScenarioRepository()
    activate PLAT
    PLAT --> CTRL : scenarioRepository
    deactivate PLAT
end

@enduml