@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class Map {
    - id
    - name
    - width
    - height
}

class Station {
    - stationID
    - ownerPlayer
    - mapName
    - scenarioName
    - mapID
    - positionX
    - positionY
    - name
    - ironCargo
    - coalCargo
    - steelCargo
    - hasIronStorage
    - hasCoalStorage
    - hasSteelStorage
    - currentCargo
    - maxCargo
    - lastYearDeliveries
    - demand
}

class StationType {
    - displayName
    - size
    - price
}

class Orientation {
    - displayName
    - shortening
}

class Building {
    - buildingType
}

class Player {
    - id
    - name
    - password
}

Map "1" - "*" Station : has
Player "1" -- "*" Station : owns
Station "1" -- "1" StationType : has
Station "1" -- "1" Orientation : has
Station "1" -- "*" Building : contains

@enduml