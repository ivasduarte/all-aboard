@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Editor
participant "AddStationUI" as UI

activate Editor

Editor -> UI : request to add a station
activate UI

UI --> Editor : request a station type
Editor -> UI : enter the station type
UI --> Editor : request the X position of the station
Editor -> UI : enter the X position of the station
UI --> Editor : request the Y position of the station
Editor -> UI : enter the Y position of the station

create "AddAStationController" as CTRL
UI --> CTRL : create()

participant "Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT

UI --> CTRL : AddStation(map, scenario, positionX, positionY, stationType, stationRotation)
activate CTRL

CTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton
RepositorySingleton --> CTRL : repositories
deactivate RepositorySingleton

CTRL -> PLAT : getMapRepository()
activate PLAT
PLAT --> CTRL : mapRepository.getMapList()
deactivate PLAT
CTRL --> CTRL : verify data
CTRL -> Station : new Station(map.getName(), mapID, positionX, positionY, type, orientation)
Station --> CTRL : return the new station
activate StationRepository
CTRL --> StationRepository : save the new station
CTRL --> Station : increase total stations
CTRL --> Scenario : subtract budget
create "StationRepository\n:StationRepository" as StationRepository

StationRepository --> CTRL : validations
deactivate StationRepository

CTRL --> UI : validations
deactivate CTRL

UI --> Editor : displays operation success or fail
deactivate UI

@enduml