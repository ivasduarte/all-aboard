@startuml
skinparam packageeStyle rectangle
skinparam shadowing false
skinparam linetype polyline

skinparam classAttributeIconSize 0

interface Runnable {
    + run(): void
}

class Station {
    - int stationID
    - String ownerPlayer
    - String mapName
    - String scenarioName
    - int mapID
    - int positionX
    - int positionY
    - StationType stationType
    - Orientation orientation
    - List<Building> buildings
    - int cargo

    + int getMapID()
    + int getPositionX()
    + int getPositionY()
    + int getStationID()
    + StationType getStationType()
    + Orientation getStationOrientation()
    + String getOwnerPlayer()
    + String getMapName()
    + String getScenarioName()
    + int getStationSize()
    + int getStationPrice()
    + String getStationTypeString()
    + String getOrientationString()
    + Map getMap()

    + void setMapName(String mapName)
    + void setScenarioName(String scenarioName)
    + void setMapID(int mapID)
    + void setPosition(int positionX, int positionY)
    + void setStationType(StationType stationType)
    + void setStationType(String stationType)
    + void setOrientation(Orientation orientation)
    + void setOrientation(String orientation)

    + boolean validatePosition(Map map, int size)
    + boolean checkOverbuilding()
}

enum Orientation {
    - String displayName
    - String shortening

    + Orientation(String displayName, String shortening)
    + getDisplayName()
    + getShortening()
    + fromString()
    + toString()
}

enum StationType {
    - String displayName
    - int size
    - int price

    + StationType(String displayName, int size, int price)
    + getDisplayName()
    + getSize()
    + getPrice()
    + fromString()
    + toString()
}

class AddStationUI implements Runnable {
    - Map map
    - Scenario scenario

    + AddStationUI(Map map, Scenario scenario)
    + getInput()
    + run()
}

class AddStationController {
    - Map map
    - Scenario scenario
    - Button backBtn
    - Button addBtn
    - ComboBox<StationType> stationTypeCmb
    - ComboBox<Orientation> orientationCmb
    - Label mapLbl
    - Label scenarioLbl
    - Label budgetLbl
    - Label orientationLbl
    - Label stationPriceLbl
    - Slider XPosSli
    - Slider YPosSli
    - TextField XPosTxt
    - TextField YPosTxt

    + void setData(Map map, Scenario scenario)
    + void initialize()
    + void handleXPosTxt()
    + void handleAddStation()
    + void handleBackToMenu()
    + String AddStation(Map map, Scenario scenario, int positionX, int positionY, int stationType, String rotation)
    + String generateStationName(String mapName, int posX, int posY, String type)
}

class StationRepository {
    - List<Station> stations

    + void save(Station station)
    + List<Station> getStations()
    + List<Station> getAvailableStationsByMapName(String mapName)
}


AddStationUI ..> AddStationController : uses
AddStationController ..> Station : creates
AddStationController ..> StationRepository : uses
StationRepository o-- "1..*" Station : manages
Station --> StationType : has
Station --> Orientation : has

@enduml
