@startuml
skinparam packageeStyle rectangle
skinparam shadowing false
skinparam linetype polyline

skinparam classAttributeIconSize 0

interface Runnable {
    + run(): void
}

class Player {
    - String name
    - String ID
    - String password
    + getPlayerName()
    + getPlayerID()
    + getPlayerPassword()
}

class UserSession {
}

class ApplicationSession {
    + static getInstance()
    + getCurrentSession()
}


class Station {
    - int totalStations

    - int stationID
    - String ownerPlayer
    - String mapName
    - String scenarioName
    - int mapID
    - int positionX
    - int positionY

    - StationType stationType
    - Orientation orientation
    - List<Building> buildings
    - int cargo

    + int getMapID()
    + int getPositionX()
    + int getPositionY()
    + int getStationID()
    + StationType getStationType()
    + Orientation getStationOrientation()
    + List<Building> getBuildings()
    + int getCargo()
    + String getOwnerPlayer()
    + String getMapName()
    + String getScenarioName()
    + int getStationSize()
    + int getStationPrice()
    + int getStationTypeID()
    + String getStationTypeString()
    + String getOrientationString()
    + Map getMap()
    + int getTotalStations()

    + void setOwnerPlayer(String ownerPlayer)
    + void setMapName(String mapName)
    + void setScenarioName(String scenarioName)
    + void setMapID(int mapID)
    + void setPosition(int positionX, int positionY)
    + void setStationType(StationType stationType)
    + void setStationType(String stationType)
    + void setOrientation(Orientation orientation)
    + void setOrientation(String orientation)

    + boolean addBuilding(Building buildingToAdd)
    + boolean isAvailable()
    + void addCargo(int amount)
    + void removeCargo(int amount)
    + boolean validatePosition(Map map, int size)
    + boolean checkOverbuilding()

    + void increaseTotalStations()
    + int checkStationType(String type)
}

enum Orientation {
    - String displayName;
    - String shortening;

    + Orientation(String displayName, String shortening)
    + getDisplayName()
    + getShortening()
    + fromString()
    + toString()
}

enum StationType {
    - String displayName;
    - int size;
    - int price

    + Orientation(String displayName, String shortening)
    + getDisplayName()
    + getSize()
    + getPrice()
    + fromString()
    + toString()
}

class AddStationUI implements Runnable {
    - Map map
    - Scenario scenario

    + AddStationUI(Map map, Scenario scenario)
    + getInput()

    + run()
}

class AddStationController {
    + String AddStation(Map map, Scenario scenario, int positionX, int positionY, String stationType, String rotation)
}

class Repositories {
    - Repositories()
    + getInstance() : repositories
    + getStationRepository()
}

class StationRepository {
    - List<Station> stations

    + void save(Station station)
    + List<Station> getStations()
    + void displayAllStations()
    + List<Station> getAvailableStationsByMapName(String mapName)
    + void copyFrom(StationRepository st2)
}

Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

AddStationUI .> AddStationController

AddStationController .> Repositories : repositories

Repositories -> "1" StationRepository
AddStationController ..> Station
AddStationController ..> StationRepository

ApplicationSession --> "1" UserSession : userSession

AddStationController ..> ApplicationSession
AddStationController ..> UserSession

StationRepository "1" --> "*" Station : stations

Station --> Player : createdBy

@enduml
