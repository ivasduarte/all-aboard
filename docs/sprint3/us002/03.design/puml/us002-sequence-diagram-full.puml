@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor Editor as player
participant "AddIndustryUI" as UI

activate player

player -> UI : requests to add an industry
activate UI

create ":AddIndustryController" as indCtrl
UI -> indCtrl : create()

loop until valid position

UI --> player : asks the industry position
player -> UI : inserts the industry position
UI -> UI : validate position

alt position is invalid
UI --> player : show error message
else position is valid
Note over UI : exit loop; continue with valid position
end

end loop

loop until valid selection

UI --> player : shows a list of the types of industry
player -> UI : selects a type of industry
UI -> UI : validate selection

alt selection is invalid
UI --> player : show error message
else selection is valid
Note over UI : exit loop; continue with valid selection of industry type
end

end loop

loop until input is valid

UI --> player : asks the cargo the industry will generate in a year
player -> UI : inserts the amount of cargo to be generated
UI -> UI : verifies if inserted input is valid

alt input is invalid
UI --> player : shows error message
else input is valid
Note over UI : exit loop; continue with valid input (positive, integer number)
end

end loop

UI -> indCtrl : addIndustry(positionX, positionY, industryType, cargoAmount)
activate indCtrl

participant ":Repositories" as REPS
participant "repositories\n:Repositories" as reps

indCtrl -> REPS : getInstance()
activate REPS

REPS --> indCtrl : repositories
deactivate REPS

indCtrl -> reps : getIndustryRepository()
activate reps

reps --> indCtrl : industryRepository
deactivate reps

create "industryRepository\n:IndustryRepository" as indRepo
indCtrl -> indRepo : save(industry)

indCtrl --> UI : success message and industry data
deactivate indCtrl

UI --> player : success message and industry data
deactivate UI

@enduml