@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as edit

participant ":AddIndustryUI" as ui
participant ":AddIndustryController" as ctrl
participant ":Industry" as ind

activate edit
edit -> ui : requests to add industry

activate ui

ui -> ctrl** : create()
ui --> edit : requests industry attributes \n(position, type, generated cargo)

edit -> ui : provides industry data

ref over ui
        Validate Position
    end

    ref over ui
        Check Overbuilding
    end

ui -> ctrl : submitData(mapID, positionX, positionY, industryType, cargoAmount)
activate ctrl

    ref over ctrl
        Get Industry Repository
    end

ctrl -> ind** : addIndustry(mapID, positionX, positionY, industryType, cargoAmount)
activate ind

ind --> ctrl : industry
deactivate ind

    ref over ctrl
        Add Industry
    end

ctrl --> ui : result
deactivate ctrl

ui --> edit : showSuccess(result)
deactivate ui

@enduml