@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber 20

participant ":addIndustryController" as CTRL
participant ":Industry" as IND
participant "industryRepository\n:IndustryRepository" as REPO

activate CTRL

CTRL -> IND : addIndustry(mapID, positionX, positionY, industryType, cargoAmount)
activate IND

group Add Industry

    IND --> CTRL : Industry Object
    deactivate IND

    CTRL -> REPO : save(map)
    activate REPO

end

@enduml
