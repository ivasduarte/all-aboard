@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber 22

actor Editor
participant ":AddIndustryUI" as UI
participant ":AddIndustryController" as CTRL
participant "industryRepository\n:IndustryRepository" as repo

activate Editor
activate UI
activate CTRL

CTRL -> repo : save(industry)
activate repo

group Add Industry Success

    repo -> CTRL : industry
    deactivate repo

    CTRL -> UI : industryData
    deactivate CTRL

    UI -> Editor : "Industry [(positionX), (positionY)] saved successfully."
    deactivate UI

end

@enduml