@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":ListStationsController" as ctrl
participant ":Station"                as st

autonumber 40

activate ctrl

    group Get Station Details

        ctrl -> st : get details
        activate st
        st --> ctrl : ID, Name, Type, Position, Cargo, Buildings
        deactivate st

    end

@enduml
