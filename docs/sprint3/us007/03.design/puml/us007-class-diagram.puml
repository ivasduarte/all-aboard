@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

class Station {
  - stationID: int
  - name: String
  - positionX: int
  - positionY: int
  - stationType: StationType
  - buildings: List<Building>
  - cargo: int
  + getStationID(): int
  + getName(): String
  + getPositionX(): int
  + getPositionY(): int
  + getStationType(): StationType
  + getBuildings(): List<Building>
  + getCargo(): int
}

class StationDTO {
  + getStationID(): int
  + getName(): String
  + getStationType(): String
  + getX(): int
  + getY(): int
  + getCargo(): int
  + getBuildings(): List<String>
}

class StationMapper {
  + toDTO(Station): StationDTO
  + toDTO(List<Station>): List<StationDTO>
  + toDomain(StationDTO): Station
  + toDomain(List<StationDTO>): List<Station>
}

enum StationType {
  DEPOT
  STATION
  TERMINAL
}

class Building {
  + getBuildingType(): String
}

class ListStationsUI {
  - map: Map
  + run(): void
  + getInput(): void
}

class ListStationsController {
  - stationRepo: StationRepository
  - currentScenario: Scenario
  - currentMap: Map
  - hasStations: boolean
  + ListStationsController()
  + setData(scenario: Scenario): void
  + loadStations(): void
  + showStationDetails(): void
  + hasStations(): boolean
}

class StationRepository {
  + getStations(): List<Station>
  + getAvailableStationsByMapName(name: String): List<Station>
}

class Repositories <<singleton>> {
  - instance: Repositories
  - stationRepo: StationRepository
  + getInstance(): Repositories
  + getStationRepository(): StationRepository
}

class Map {
  - name: String
  - width: int
  - height: int
  - stations: List<Station>
  + getName(): String
  + getStations(): List<Station>
}

class Scenario {
  - map: Map
  + getMap(): Map
}

interface Runnable <<interface>> {
  + run(): void
}


ListStationsController ..> StationMapper : uses
ListStationsUI ..> StationDTO : displays

ListStationsUI ..|> Runnable : implements
ListStationsUI ..> ListStationsController : uses

ListStationsController ..> StationRepository : accesses
ListStationsController ..> Scenario : receives from
ListStationsController ..> Map : uses

Repositories ..> StationRepository : provides

Station --> Building : contains
Station ..> StationType : has
Station --> Map : belongs to

Map --> Scenario : belongs to

@enduml
