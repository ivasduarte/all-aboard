@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide methods
hide circle

class Map {
  - name
  - width: int
  - height: int
}

class Scenario {
  - name
}

class Station {
  - stationID
  - name
  - positionX
  - positionY
  - type
  - cargo
}

class Building {
  - type
}

enum StationType {
  DEPOT
  STATION
  TERMINAL
}

Scenario "1" -- "1" Map: has
Map "1" -- "*" Station : contains
Scenario "1" -- "*" Station : manages
Station "1" -- "*" Building : has
Station --> StationType : type

@enduml
