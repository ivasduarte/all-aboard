@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor Editor

participant ":SaveScenarioUI" as UI
participant ":SaveScenarioController" as ctrl
participant ":Repositories" as reps
participant "mapRepository\n:MapRepository" as repo
participant "scenarioRepository\n:ScenarioRepository" as srepo


activate Editor
Editor -> UI : requests to save a scenario
activate UI

create ctrl
UI -> ctrl : constructor

UI -> ctrl : getMapList()
activate ctrl
ctrl -> reps : getInstance()
activate reps
reps --> ctrl : instance
deactivate reps

ctrl -> repo : getMapRepository()
activate repo
repo --> ctrl : mapRepository
ctrl -> repo : getMapList()
repo --> ctrl : mapsList
deactivate repo
ctrl --> UI : mapsList
deactivate ctrl

UI --> Editor : shows maps to select
Editor -> UI : selects map

UI -> ctrl : getScenarioList(map)
activate ctrl
ctrl -> srepo : getScenarioListByMap(map)
activate srepo
srepo --> ctrl : scenariosList
deactivate srepo
ctrl --> UI : scenariosList
deactivate ctrl

UI --> Editor : asks to select a scenario
Editor -> UI : selects a scenario

UI -> ctrl : saveScenarioInFile(scenario)
activate ctrl
ctrl -> srepo : scenarioToFile(scenario)
activate srepo

alt file does not exist
    srepo -> srepo : save file directly
    srepo --> ctrl : saved scenario
    ctrl --> UI: operation success
    UI --> Editor: shows message of success
else file already exists
    srepo -> UI : ask overwrite confirmation
    UI -> Editor : confirm overwrite
    Editor --> UI : Y/N

    opt if user says N
        srepo -> srepo : cancel save
        srepo --> ctrl : save cancelled
        ctrl --> UI : scenario not saved
        UI --> Editor : operation cancelled
        deactivate srepo
        deactivate ctrl

    end

end

deactivate srepo
ctrl --> UI : saved scenario
deactivate ctrl

UI --> Editor : shows message of success
deactivate UI

@enduml
