@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateCityController" as CTRL
participant ":City" as City
participant "cityRepo\n:CityRepository" as cityRepo

autonumber 18
-> CTRL**: create
group Create City
CTRL-> City**: createCity(name, map, x, y)

CTRL -> cityRepo : add(city)
activate cityRepo
deactivate cityRepo

note right of CTRL: there is an interaction between UI and Controller\n to get the number of house blocks
loop for each block to add
  CTRL -> HouseBlock** : create(x, y)
  CTRL -> cityRepo : isBlockPositionUnique(map, block)
  activate cityRepo
  cityRepo --> CTRL : isUnique
  deactivate cityRepo
  CTRL -> City : addBlockManual(block)
  activate City
  deactivate City
end
end group
<-- CTRL: success


@enduml