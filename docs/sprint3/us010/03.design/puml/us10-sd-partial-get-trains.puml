@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":AssignRouteController" as CTRL
participant "trainRepository\n:TrainRepository" as trainRepo

autonumber 10

activate CTRL

    group Get Trains
        CTRL -> trainRepo : getAvailableTrains()
        activate trainRepo
        trainRepo --> CTRL : trainList
        deactivate trainRepo
    end

@enduml