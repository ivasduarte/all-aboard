@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Editor
participant "AssignRouteUI" as UI

activate Editor

Editor -> UI : request to assign a route
activate UI

UI --> Editor : shows a list of the available locomotives
Editor -> UI : selects a locomotive
UI --> Editor : shows a list of the available stations
Editor -> UI : selects the desired stations


create "AssignRouteController" as CTRL
UI --> CTRL : create

UI --> CTRL : AssignRoute(locomotive, route)
activate CTRL

CTRL -> CTRL : AssignRoute(locomotive, route)

CTRL --> UI : verifications
deactivate CTRL

UI --> Editor : displays operation success or failure
deactivate UI

@enduml