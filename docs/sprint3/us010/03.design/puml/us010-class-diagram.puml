@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline

skinparam classAttributeIconSize 0

interface Runnable {
    + run(): void
}

class Player {
    - String name
    - String ID
    - String password
    + getPlayerName()
    + getPlayerID()
    + getPlayerPassword()
}

class UserSession {
    - Player currentPlayer
    + getCurrentPlayer(): Player
}

class Train {
    - Locomotive locomotive
    - List<PointOfRoute> route
    - int departureYear
    - double arrivalTime
    - List<Carriage> carriages
    - boolean isDoubleTrack
    - int currentCargo

    + getRoute(): List<PointOfRoute>
    + setRoute(List<PointOfRoute> pointOfRoutes): void
    + setRouteWithStations(List<Station> stations): void
    + getLocomotive(): Locomotive
    + getNumberOfCarriages(): int
    + getCarriages(): List<Carriage>
    + setNumberOfCarriages(int numberOfCarriages): void
    + setCargoMode(int pointIndex, CargoMode mode): void
    + isReadyToDepart(int pointIndex, int currentLoad): boolean
}

class Station {
    - String id
    - String name
    - String type
    - int positionX
    - int positionY
    - String mapName
    - String ownerPlayer
    - Map<CargoType, Integer> cargoSupply
    - Map<CargoType, Integer> cargoDemand

    + getId(): String
    + getName(): String
    + getPositionX(): int
    + getPositionY(): int
    + getMapName(): String
    + getOwnerPlayer(): String
    + distanceTo(Station other): double
}

class PointOfRoute {
    - Station station
    - CargoMode cargoMode

    + getStation(): Station
    + getCargoMode(): CargoMode
    + setCargoMode(CargoMode mode): void
    + isReadyToDepart(int currentLoad, int maxCapacity): boolean
}

enum CargoMode {
    FULL
    HALF
    AVAILABLE
}

class AssignRouteController {
    - Map map
    - Scenario scenario
    - TrainRepository trainRepository
    - StationRepository stationRepository

    + setData(Map map, Scenario scenario): void
    + handleAddPointOfRoute(): void
    + handleAssignRoute(): void
    + assignRoute(Train train, List<PointOfRoute> pointOfRoutes): void
    + assignRouteWithStations(Train train, List<Station> stations): void
    + setCargoMode(Train train, int pointIndex, CargoMode mode): void
    + checkValidation(): boolean
}

class AssignRouteUI implements Runnable {
    - Map map
    - Scenario scenario

    + AssignRouteUI(Map map, Scenario scenario)
    + void getInput()
    + void run()
}

class ApplicationSession {
    + static getInstance(): ApplicationSession
    + getCurrentSession(): UserSession
}

class Repositories {
    - static Repositories instance
    - TrainRepository trainRepository
    - StationRepository stationRepository

    - Repositories()
    + static getInstance(): Repositories
    + getTrainRepository(): TrainRepository
    + getStationRepository(): StationRepository
}

class TrainRepository {
    - List<Train> trains
    - List<Train> availableTrains

    + saveTrain(Train train): void
    + getAvailableTrains(): List<Train>
    + getTrainById(String id): Train
}

class StationRepository {
    - List<Station> stations

    + getAllStations(): List<Station>
    + getStationById(String id): Station
}

class Map {
    - String name
    - List<Station> stations
    + getName(): String
    + getStations(): List<Station>
}

class Scenario {
    - List<Train> trains
    + getTrains(): List<Train>
}

class Locomotive {
    - String locomotiveModel
    - String locomotiveFuelType
    - int maxSpeed
    + getLocomotiveModel(): String
    + getLocomotiveFuelType(): String
    + getMaxSpeed(): int
}

class Carriage {
    - Cargo cargo
    - int maxCargo
    - int currentCargo
    + getMaxCargo(): int
    + getCurrentCargo(): int
}

' composition
Train "1" *-- "1" Locomotive : has
Train "1" *-- "*" PointOfRoute : contains
Train "1" *-- "*" Carriage : has
PointOfRoute "1" *-- "1" Station : references
PointOfRoute "1" *-- "1" CargoMode : has
Carriage "1" *-- "1" Cargo : has

' agregation
Repositories "1" o-- "1" TrainRepository : contains
Repositories "1" o-- "1" StationRepository : contains
ApplicationSession "1" o-- "1" UserSession : contains
UserSession "1" o-- "1" Player : contains
Map "1" o-- "*" Station : contains
Scenario "1" o-- "*" Train : contains

' dependencies
AssignRouteUI ..> AssignRouteController : uses
AssignRouteController ..> Repositories : uses
AssignRouteController ..> Train : uses
AssignRouteController ..> Station : uses
AssignRouteController ..> PointOfRoute : uses
AssignRouteController ..> CargoMode : uses
AssignRouteController ..> Map : uses
AssignRouteController ..> Scenario : uses
AssignRouteUI ..> Map : uses
AssignRouteUI ..> Scenario : uses
AssignRouteUI ..> UserSession : uses

TrainRepository "1" o-- "*" Train : manages
StationRepository "1" o-- "*" Station : manages

@enduml
