@startuml
skinparam packageeStyle rectangle
skinparam shadowing false
skinparam linetype polyline

skinparam classAttributeIconSize 0

interface Runnable {
    + run(): void
}

class Player {
    - String name
    - String ID
    - String password
    + getPlayerName()
    + getPlayerID()
    + getPlayerPassword()
}

class UserSession {
}

class Locomotive{
    - String locomotiveModel;
    - String fuelType;
    - int speed;
    - int startYear;
    - int endYear;
    - int price;
    - int fuelCost;
    - int maintenanceCost;
    - List<Station> route;

    + String getLocomotiveModel()
    + String getLocomotiveFuelType()
    + int getPrice()
    + int getStartYear()
    + int getEndYear()
    + int getFuelCost()
    + int getMaintenanceCost()
    + List<Station> getRoute()
    + void setRoute(List<Station> route)
}


class ApplicationSession {
    + static getInstance()
    + getCurrentSession()
}


class AssignRouteUI implements Runnable {
    - Map map
    - Scenario scenario

    + AssignRouteUI(Map map, Scenario scenario)
    + void getInput()
    + void run()
}

class AssignRouteController {
    + AssignRoute(Locomotive locomotive, List<Station> route)
}

class Repositories {
    - Repositories()
    + getInstance() : repositories
    + getLocomotiveRepository()
}

class LocomotiveRepository {
    - List<Locomotive> locomotives
    - List<Locomotive> availableLocomotives
    - List<Locomotive> playerLocomotives

    + void saveLocomotive(Locomotive locomotive)
    + void save(Locomotive locomotive)
    + List<Locomotive> getAllLocomotives()
    + List<Locomotive> getAvailableLocomotives(int scenarioId)
    + List<Locomotive> getPlayerLocomotives()
    + Locomotive getLocomotiveByModel()
}

Player -> AssignRouteUI : calls
Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

AssignRouteUI .> AssignRouteController

AssignRouteController .> Repositories : repositories

Repositories --> "1" LocomotiveRepository
AssignRouteController ..> Locomotive

ApplicationSession --> "1" UserSession : userSession

AssignRouteController ..> ApplicationSession
AssignRouteController ..> UserSession


@enduml
