@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class RailwayLine{
    - id
    - name
    - size
}

class Train{
    - name
    - ID
    - dateOfPurchase
    - isAvailable
    - currentLocation
}

class Station {
    - id
    - name
    - type
    - building
    - cargoDemand
    - cargoSupply
}

class Player {
    - id
    - name
    - password
}

class Route{
    - id
    - stations
    - cargoList
}

class Cargo{
    - type
    - quantity
    - sourceStation
    - destinationStation
}

Player "1" - "1" Train : selects
Player "1" -- "1" Station : selects
Player "1" -- "1" RailwayLine : assigns

Train "1" - "1" Route : has
Route "*" -- "1" Station : contains
Route "*" -- "*" Cargo : transports
Station "*" -- "*" RailwayLine : connected by

@enduml