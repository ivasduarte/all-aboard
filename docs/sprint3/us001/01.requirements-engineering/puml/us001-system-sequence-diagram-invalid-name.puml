@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant "System" as System

activate Editor

    Editor -> System : Request to create a new map
    activate System

    System --> Editor : Prompt for map name
    deactivate System

    Editor -> System : Submit **invalid** map name
    activate System

    alt name already exists
        System --> Editor: Display error message:\n"Name already exists. Please enter a different name:"
    else invalid name format
        System --> Editor : Display error message: ""ERROR: Map name is\ntoo long. Max length is 15 characters. ERROR: Map name contains\ninvalid characters."
        deactivate System
    end

     Editor -> System : Submit **valid** map name
        activate System

        System --> Editor: Prompt for map width
        deactivate System

        Editor -> System: Submit **valid** map width
        activate System

        System --> Editor: Prompt for map height
        deactivate System

        Editor -> System: Submit **valid** map height
        activate System

        System --> Editor: Prompt for cell block size
        deactivate System

        Editor -> System: Submit **valid** cell block size
        activate System

        System --> Editor: Display success message: "Map created successfully."

    deactivate System
    deactivate Editor

@enduml
