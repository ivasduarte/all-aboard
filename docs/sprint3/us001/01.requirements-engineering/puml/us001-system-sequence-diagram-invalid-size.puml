@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant "System" as System

activate Editor

    Editor -> System : Request to create a new map
    activate System

    System --> Editor : Prompt for map name
    deactivate System

     Editor -> System : Submit **valid** map name
        activate System

        System --> Editor: Prompt for map width
        deactivate System

        alt invalid map width
            Editor -> System: Submit **invalid** map width
            activate System

            System --> Editor: Display error message: "ERROR: Invalid width. Please enter\na positive integer less than or equal to 256."
            deactivate System
        else invalid map height
            Editor -> System: Submit **invalid** map height
            activate System

            System --> Editor: Display error message: "ERROR: Invalid height. Please enter\na positive integer less than or equal to 256."
            deactivate System
        else invalid cell block size
            Editor -> System: Submit **invalid** cell block size
            activate System

            System --> Editor: Display error message: "ERROR: Invalid size. Please enter\na positive integer."
            deactivate System
        end

        Editor -> System: Submit **valid** map width
        activate System

        System --> Editor: Prompt for map height
        deactivate System

        Editor -> System: Submit **valid** map height
        activate System

        System --> Editor: Prompt for cell block size
        deactivate System

        Editor -> System: Submit **valid** cell block size
        activate System

        System --> Editor: Display success message: "Map created successfully."

    deactivate System
    deactivate Editor

@enduml

