@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Map {
    - name: String
    - size: Size
    - scenarios: List<Scenario>
    - stations: List<Station>
    - cities: List<City>
    - industries: List<Industry>
}

class Size {
    - width: int
    - height: int
    - cellSizeKm: int
}

class Scenario
class Station
class City
class Industry

class NameValidationRule {
    - message: String
}

class SizeValidationRule {
    - maxWidth: int = 256
    - maxHeight: int = 256
}

class CellSizeValidationRule {
    - minCellSize: int = 1
}

class User {
    - email: String
    - password: String
}

User "1" -- "*" Map : creates
Map "1" -- "1" Size : has
Map "1" -- "*" Scenario : includes
Map "1" -- "*" Station : contains
Map "1" -- "*" City : contains
Map "1" -- "*" Industry : contains

Map "1" -- "*" NameValidationRule : validatedBy
Size "1" -- "*" SizeValidationRule : validatedBy
Size "1" -- "*" CellSizeValidationRule : validatedBy

@enduml