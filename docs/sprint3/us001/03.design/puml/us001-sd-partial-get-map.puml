@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":CreateMapController" as ctrl
participant "Repositories" as Reps
participant "repositories\n:Repositories" as reps
participant "mapRepository\n:MapRepository" as repo

autonumber 5

   -> ctrl : submitData()
   activate ctrl

group Get Map Repository
   ctrl -> reps : getInstance()
   activate reps

   reps --> ctrl : instance
   deactivate reps

   ctrl -> repo : getMapRepository()
   activate repo

   repo --> ctrl : mapRepository
   deactivate repo
end

@enduml