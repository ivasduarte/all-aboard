@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor Editor

participant ":CreateMapUI" as UI
participant ":CreateMapController" as ctrl
participant ":Repositories" as reps
participant "repositories\n:Repositories" as repositories
participant "mapRepository\n:MapRepository" as repo
participant ":Map" as Map

activate Editor
Editor -> UI : requests to create a map

activate UI
UI -> ctrl : create()
activate ctrl

ctrl -> reps : getInstance()
activate reps
reps --> ctrl : instance
deactivate reps

ctrl -> repo : getMapRepository()
activate repo
repo --> ctrl : mapRepository
deactivate repo

ctrl -> UI : requests map name
deactivate ctrl

loop while mapName already exists
    UI --> Editor: requestMapName()
    deactivate UI

    Editor --> UI : provides mapName
    activate UI

    UI -> ctrl : submitMapName(mapName)
    activate ctrl

    ctrl -> repo : existsByName(mapName)
    activate repo
    repo --> ctrl : true
    deactivate repo

    ctrl -> UI : showError("Map name already exists.")
    deactivate ctrl

    UI --> Editor: display error message
    UI --> Editor: prompt for new mapName
    deactivate UI
end

Editor -> UI: provides unique mapName
activate UI

UI -> ctrl : submitMapName(mapName)
activate ctrl

ctrl -> UI : requests map width
deactivate ctrl

UI --> Editor: requestWidth()
deactivate UI

Editor --> UI : provides width
activate UI

UI -> ctrl : submitWidth(width)
activate ctrl

ctrl -> UI : requests map height
deactivate ctrl

UI --> Editor: requestHeight()
deactivate UI

Editor --> UI : provides height
activate UI

UI -> ctrl : submitHeight(height)
activate ctrl

ctrl -> UI : requests cell size
deactivate ctrl

UI --> Editor: requestCellSize()
deactivate UI

Editor --> UI: provides cellSizeKm
activate UI

UI -> ctrl : submitData(mapName, width, height, cellSizeKm)
activate ctrl

ctrl -> Map : createMap(mapName, width, height, cellSizeKm)
activate Map

Map -> Map : validateName()
Map -> Map : validateSize()

Map --> ctrl : Map object
deactivate Map
ctrl -> repo : add(map)
activate repo

repo -> repo : validateMap(map)
repo --> ctrl : map
deactivate repo

ctrl --> UI : map
deactivate ctrl

UI --> Editor : "Map successfully created!"
deactivate UI

@enduml