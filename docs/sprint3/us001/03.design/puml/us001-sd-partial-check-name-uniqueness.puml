@startuml
autonumber 10

participant ":CreateMapController" as ctrl
participant "mapRepository\n:MapRepository" as repo

-> ctrl: submitData(mapName)
activate ctrl

group Check Map Name Uniqueness
    loop while mapName exists
        ctrl -> repo : existsByName(mapName)
        activate repo
        repo --> ctrl : true
        deactivate repo
        <- ctrl: showError("Map name already exists.")
    end
end
@enduml