@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber 6

participant ":CreateMapController" as ctrl
participant ":Repositories" as reps
participant "mapRepository\n:MapRepositories" as repo
participant ":CreateMapUI" as UI

ctrl -> reps : getInstance()
activate reps
reps --> ctrl : instance
deactivate reps

group Check Map Name Uniqueness
    ctrl -> repo : getMapRepository()
    activate repo
    repo --> ctrl : mapRepository
    deactivate repo

    loop while mapName exists
      ctrl -> repo : existsByName(mapName)
      activate repo
      repo --> ctrl : true
      deactivate repo

      ctrl -> UI : show error "Map name already exists"
      deactivate ctrl

      UI --> ctrl : new mapName
      activate ctrl
    end

    ctrl -> repo : existsByName(mapName)
    activate repo
    repo --> ctrl : false
    deactivate repo
end
@enduml