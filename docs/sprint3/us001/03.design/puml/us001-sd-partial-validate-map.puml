@startuml
autonumber 32

participant ":CreateMapController" as ctrl
participant ":Map" as Map

activate ctrl

group Validate Map
    ctrl -> Map : createMap(mapName, width,\nheight, cellSizeKm)
    activate Map

    Map -> Map : validateName()
    Map -> Map : validateSize()
    Map --> ctrl : Map object
    deactivate Map
end

@enduml