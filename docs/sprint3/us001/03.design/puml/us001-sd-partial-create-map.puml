@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber 21

participant ":CreateMapController" as ctrl
participant ":Map" as Map
participant "mapRepository\n:MapRepositories" as repo

ctrl -> Map : new Map(mapName, width, height)
activate Map

group Create New Map
    Map -> Map : validateName()
    Map -> Map : validateSize()
    Map --> ctrl : Map object
    deactivate Map

    ctrl -> repo : add(map)
    activate repo
end

@enduml