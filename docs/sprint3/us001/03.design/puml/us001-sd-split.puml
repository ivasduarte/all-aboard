@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor Editor

participant ":CreateMapUI" as UI
participant ":CreateMapController" as ctrl
participant ":Map" as Map

activate Editor
Editor -> UI : requests to create a map


activate UI
UI -> ctrl** : create()

UI -> Editor : requestMapName()
deactivate UI

Editor --> UI : provides mapName
activate UI

UI -> ctrl : submitData()
activate ctrl

    ref over ctrl
        Get Map Repository
    end

    ref over ctrl
        Check Name Uniqueness
    end


UI -> Editor : requestWidth()
deactivate UI

Editor --> UI : provides width
activate UI

UI -> Editor : requestHeight()
deactivate UI

Editor --> UI : provides height
activate UI

UI -> ctrl : submitData()
ctrl -> Map : new Map(mapName, width, height)
activate Map

    ref over Map
        Validate Map
    end

Map --> ctrl : map
deactivate Map

    ref over ctrl
        Add Map
    end

ctrl --> UI : map
deactivate ctrl

UI --> Editor : "Map (name) successfully created!"
deactivate UI
@enduml