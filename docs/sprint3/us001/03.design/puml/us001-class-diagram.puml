@startuml
skinparam classAttributeIconSize 0

class Map {
    -name: String
    -width: int
    -height: int
    -cellSizeKm: int
    +Map(name, width, height, cellSizeKm)
    +getMapName(): String
    +getWidth(): int
    +getHeight(): int
    +validateName(): void
    +validateSize(): void
    +toString(): String
}

interface Runnable <<interface>> {
    +run(): void
}

class CreateMapUI {
    -controller: CreateMapController
    -mapRepository: MapRepository
    -mapName: String
    -width: int
    -height: int
    +getController(): CreateMapController
    +getMapRepository(): MapRepository
    +run(): void
    +getInput(): void
    +requestMapName(): String
    +requestWidth(): int
    +requestHeight(): int
    +requestSize(): int
    +submitData(): void
}

class CreateMapController {
    +createMap(name, width, height, cellSizeKm): Map
}

class MapRepository {
    -maps: List<Map>
    +add(map: Map): void
    +validateMap(map: Map): boolean
    +existsByName(name: String): boolean
    +getMapList(): List<Map>
    +getMap(name: String): Optional<Map>
}

class Repositories {
    -instance: Repositories {static}
    -mapRepository: MapRepository
    +Repositories()
    +getInstance(): Repositories
    +getMapRepository(): MapRepository
}

class ApplicationSession {
    -instance: ApplicationSession {static}
    -userSession: UserSession
    +getInstance(): ApplicationSession {static}
    +getCurrentSession(): UserSession
    +setUserSession(): void
}

class UserSession {
    -instance: UserSession {static}
    -user: UserSession
    +getInstance(): UserSession {static}
}

CreateMapUI ..|> Runnable

CreateMapUI --> CreateMapController : controller (1)
CreateMapUI --> MapRepository : mapRepository (1)

CreateMapController --> Map : creates
CreateMapController --> MapRepository : uses (1)
CreateMapController --> ApplicationSession : accesses
ApplicationSession --> UserSession : currentSession (1)

Repositories --> MapRepository : provides (1)
MapRepository --> "*" Map : manages

@enduml