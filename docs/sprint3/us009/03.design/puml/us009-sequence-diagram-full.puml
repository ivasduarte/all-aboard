@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuyLocomotiveUI" as UI
participant ":CreateScenarioController" as ScenarioCtrl
participant ":BuyLocomotiveController" as CTRL
participant ":Repositories" as reps
participant "repositories\n:Repositories" as PLAT
participant "locomotiveRepo\n:LocomotiveRepository" as LocomotiveRepo
participant "scenarioRepo\n:ScenarioRepository" as ScenarioRepo
participant "scenario:\nScenario" as ScenarioObj

activate Player

Player -> UI : requests to buy a locomotive

activate UI
UI -> CTRL** : create
UI -> ScenarioCtrl** : create

UI -> ScenarioCtrl : getScenarioList()
activate ScenarioCtrl
ScenarioCtrl -> reps : getInstance()
activate reps
reps --> ScenarioCtrl : repositories
deactivate reps

ScenarioCtrl -> PLAT : getScenarioRepository()
activate PLAT
PLAT --> ScenarioCtrl : scenarioRepository
deactivate PLAT

ScenarioCtrl -> ScenarioRepo : getScenarioList()
activate ScenarioRepo
ScenarioRepo --> ScenarioCtrl : scenarioList
deactivate ScenarioRepo

ScenarioCtrl --> UI : scenarioList
deactivate ScenarioCtrl

UI -> Player : displays list of scenarios
Player -> UI : selects scenario

UI -> CTRL : getLocomotiveRepository()
activate CTRL
CTRL -> reps : getInstance()
activate reps
reps --> CTRL : repositories
deactivate reps

CTRL -> PLAT : getLocomotiveRepository()
activate PLAT
PLAT --> CTRL : locomotiveRepository
deactivate PLAT
CTRL --> UI : locomotiveRepository
deactivate CTRL

UI -> LocomotiveRepo : getAvailableLocomotives(scenarioId)
activate LocomotiveRepo
LocomotiveRepo --> UI : availableLocomotives
deactivate LocomotiveRepo

UI -> Player : displays available locomotives
Player -> UI : selects locomotive model

UI -> CTRL : buyLocomotive(locomotiveModel, mapName)
activate CTRL

CTRL -> reps : getInstance()
activate reps
reps --> CTRL : repositories
deactivate reps

CTRL -> PLAT : getLocomotiveRepository()
activate PLAT
PLAT --> CTRL : locomotiveRepository
deactivate PLAT

CTRL -> PLAT : getScenarioRepository()
activate PLAT
PLAT --> CTRL : scenarioRepository
deactivate PLAT

CTRL -> ScenarioRepo : getScenarioList()
activate ScenarioRepo
ScenarioRepo --> CTRL : scenarioList
deactivate ScenarioRepo

CTRL -> CTRL : find scenario by mapName

CTRL -> LocomotiveRepo : getLocomotiveByModel(locomotiveModel)
activate LocomotiveRepo
LocomotiveRepo --> CTRL : locomotive
deactivate LocomotiveRepo

CTRL -> ScenarioObj : getBudget()
activate ScenarioObj
ScenarioObj --> CTRL : budget
deactivate ScenarioObj

CTRL -> ScenarioObj : subtractBudget(locomotive.getPrice())
activate ScenarioObj
ScenarioObj --> CTRL : updatedBudget
deactivate ScenarioObj

CTRL -> LocomotiveRepo : save(locomotive)
activate LocomotiveRepo
deactivate LocomotiveRepo

CTRL --> UI : successMessage
deactivate CTRL

UI --> Player : displays purchase success
deactivate UI

deactivate Player
@enduml
