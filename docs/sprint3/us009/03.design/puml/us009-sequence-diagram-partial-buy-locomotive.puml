@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":BuyLocomotiveController" as CTRL
participant "locomotiveRepo\n:LocomotiveRepository" as LocomotiveRepo
participant "scenario:\nScenario" as ScenarioObj


autonumber 14
group Buy Locomotive
CTRL -> LocomotiveRepo : getLocomotiveByModel(locomotiveModel)
activate LocomotiveRepo
LocomotiveRepo --> CTRL : locomotive
deactivate LocomotiveRepo

CTRL -> ScenarioObj : getBudget()
activate ScenarioObj
ScenarioObj --> CTRL : budget
deactivate ScenarioObj

CTRL -> ScenarioObj : subtractBudget(locomotive.getPrice())
activate ScenarioObj
ScenarioObj --> CTRL : updatedBudget
deactivate ScenarioObj

CTRL -> LocomotiveRepo : save(locomotive)
activate LocomotiveRepo
deactivate LocomotiveRepo
end
<-- CTRL : successMessage



@enduml