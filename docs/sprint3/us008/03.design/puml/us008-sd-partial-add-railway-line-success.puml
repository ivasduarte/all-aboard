@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber 26

actor Player
participant ":BuildRailwayLineUI" as UI
participant ":BuildRailwayLineController" as CTRL
participant "railwayLineRepository\n:RailwayLineRepository" as repo

activate Player
activate UI
activate CTRL

CTRL -> repo : save(railwayLine)
activate repo

group Add Railway Line Success

    repo -> CTRL : railwayLine data
    deactivate repo

    CTRL -> UI : railwayLine data
    deactivate CTRL

    UI -> Player : shows success message with railway line data
    deactivate UI

end

@enduml