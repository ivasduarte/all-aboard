@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Editor
participant "BuildRailwayLineUI" as UI

activate Editor

Editor -> UI : requests to build a railway line
activate UI

create ":BuildRailwayLineController" as railCTRL
UI --> railCTRL : create()

create ":AddStationController" as cityCTRL
UI --> cityCTRL : create()

participant ":Repositories" as RepositorySingleton
participant "repositories\n:Repositories" as PLAT
participant "railwayLineRepository\n:RailwayLineRepository" as railwayLineRepository
participant ":RailwayLine" as RailwayLine
participant "stationRepository\n:StationRepository" as cityRepo
participant "StationMapper" as cityMapper
participant "StationDTO" as cityDTO

UI -> cityCTRL : getStationsList()
activate cityCTRL

cityCTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton
RepositorySingleton --> cityCTRL : repositories
deactivate RepositorySingleton

cityCTRL -> PLAT : getStationRepository()
activate PLAT
PLAT --> cityCTRL : stationRepository
deactivate PLAT

cityCTRL -> cityRepo : getStationsList()
activate cityRepo
cityRepo --> cityCTRL : stationsList
deactivate cityRepo

cityCTRL -> cityMapper : getStationsDTOList(stationsList)
activate cityMapper

loop for each city in cityList
    cityMapper --> cityDTO : StationDTO = toDTO(station)
    activate cityDTO
    deactivate cityDTO
end loop

cityMapper --> cityCTRL : stationDTOList
deactivate cityMapper

cityCTRL --> UI : stationDTOList
deactivate cityCTRL

UI --> Editor : displays list of available stations
Editor -> UI : selects two stations

UI --> Editor : requests the type of railway line
Editor -> UI : inserts the type of railway line

UI --> railCTRL : buildRailwayLine(first station, second station, type of railway line)
activate railCTRL

railCTRL -> RepositorySingleton : getInstance()
activate RepositorySingleton
RepositorySingleton --> railCTRL : repositories
deactivate RepositorySingleton

railCTRL -> PLAT : getRailwayLineRepository()
activate PLAT
PLAT --> railCTRL : railwayLineRepository
deactivate PLAT

railCTRL -> RailwayLine : buildRailwayLine(first station, second station, type of railway line)
activate RailwayLine

RailwayLine --> railCTRL : Object RailwayLine
deactivate RailwayLine

railCTRL -> railwayLineRepository : save(railwayLine)
activate railwayLineRepository

railwayLineRepository --> railCTRL : railwayLine data
deactivate railwayLineRepository

railCTRL --> UI : railwayLine data
deactivate railCTRL

UI --> Editor : shows success message with railway line data
deactivate UI

@enduml