@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":UpgradeAStationController" as ctrl
participant ":BuildingRepository" as bd

activate ctrl

autonumber 28

    group Get Available Building Types

        ctrl -> bd : getBuildingTypes()
        activate bd
        bd --> ctrl : List<BuildingType>
        deactivate bd
        ctrl -> ctrl : etFilteredAvailableBuildingTypes(Station station, int currentYear)

    end


@enduml