@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":UpgradeAStationUI" as ui
participant ":Scenario" as s

activate ui

autonumber 37

    group Get Budget

        ui -> s : getBudget()
        activate s
        s --> ui : budget
        deactivate s

    end


@enduml