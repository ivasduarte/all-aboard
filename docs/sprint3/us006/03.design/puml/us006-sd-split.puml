@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeAStationUI" as UI
participant ":UpgradeAStationController" as CTRL
participant ":Scenario" as Scenario

activate Player

Player -> UI : start the simulation
activate UI
UI --> Player : shows list of maps
Player -> UI : selects map
UI --> Player : shows list of scenarios
Player -> UI : selects scenario
UI --> Player : shows list of actions
Player -> UI : selects “Upgrade Station”

UI -> CTRL : create()
activate CTRL

ref over CTRL
    Get Station Repositories
end

ref over CTRL
    Get Available Stations
end

CTRL --> UI : send stations
UI --> Player : show stations
Player -> UI : selects station
UI -> CTRL : send selected station

CTRL -> Scenario : getCurrentYear()
activate Scenario
Scenario --> CTRL : currentYear
deactivate Scenario

CTRL -> CTRL : removeObsoleteBuildings(station, currentYear)

ref over CTRL
    Get Building Repository
end

ref over CTRL
    Get Available Building Types
end

CTRL --> UI : send building types
UI --> Player : show building options
Player -> UI : selects building type (“Large Hotel”)

ref over CTRL
    Get Building Type
end

UI -> CTRL : request upgrade (station, building)

ref over CTRL
    Upgrade Station
end

alt on success
    ref over CTRL
        Subtract Budget
    end

    CTRL --> UI : Building added successfully
    UI --> Player : Building added successfully
else on failure
    CTRL --> UI : Upgrade failed
    UI --> Player : Show error message
end

deactivate CTRL
deactivate UI
@enduml
