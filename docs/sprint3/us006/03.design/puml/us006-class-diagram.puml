@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

class Station {
  - mapID: int
  - positionX: int
  - positionY: int
  - stationID: int
  - stationType: Station.StationType
  - orientation: Station.Orientation
  - buildings: List<Building>
  + getStationID(): int
  + getBuildings(): List<Building>
  + addBuilding(b: Building): boolean
  + getStationTypeString(): String
  + getOrientationString(): String
  + isAvailable(): boolean
  + getMap(): Map
}

class Building {
  + getBuildingType(): String
  + getCost(): int
  + getEffect(): String
}

class BuildingType {
  - name: String
  - cost: int
  - effect: String
  - availableYear: int
  + getName(): String
  + getCost(): int
  + getEffect(): String
  + getAvailableYear(): int
}

class StationUpgradeService {
  + upgradeStation(station: Station, building: Building, currentYear: int): boolean
  + validateYear(String type, int year): boolean
  + checkMutualExclusivity(List<Building> existingBuildings, String newType): String
}

class UpgradeAStationController {
  - stationRepo: StationRepository
  - buildingRepo: BuildingRepository
  - upgradeService: StationUpgradeService
  + getAvailableStations(mapName: String): List<Station>
  + getAvailableBuildingTypes(): List<BuildingType>
  + upgradeStation(station: Station, buildingTypeName: String, year: int): boolean
  + removeObsoleteBuildings(station: Station, year: int): void
}

enum StationType {
  DEPOT
  STATION
  TERMINAL
}

class StationRepository {
  + getAvailableStationsByMapName(mapName: String): List<Station>
}

class BuildingRepository {
  + getBuildingTypes(): List<BuildingType>
  + getBuildingType(name: String): BuildingType
}

class Repositories <<singleton>> {
  - instance: Repositories
  - stationRepo: StationRepository
  - buildingRepo: BuildingRepository
  + getInstance(): Repositories
  + getStationRepository(): StationRepository
  + getBuildingRepository(): BuildingRepository
}

class UpgradeAStationUI {
  - map: Map
  - scenario: Scenario
  + run(): void
  + getInput(): void
}

interface Runnable <<interface>> {
    +run(): void
}

class Map {
  - name: String
  - width: int
  - height: int
  - scenarios: List<Scenario>
  + getName(): String
  + getWidth(): int
  + getHeight(): int
  + getScenarios(): List<Scenario>
  + addNewScenario(s: Scenario): void
  + removeScenario(s: Scenario): boolean
  + hasScenario(s: Scenario): boolean
}

class Scenario {
  - budget: Budget
  - currentYear: int
  + getCurrentYear()
  + getBudget()
  + setBudget(Budget budget)
}

class BuildingTypeDTO  {
  -name: String
  -cost: int
  -effect: String
  -availableYear: int
}

class BuildingTypeMapper  {
  +toDTO(BuildingType): BuildingTypeDTO
  +toDomain(BuildingTypeDTO): BuildingType
}

BuildingTypeMapper --> BuildingType
BuildingTypeMapper --> BuildingTypeDTO
UpgradeAStationController ..> BuildingTypeMapper : uses



Station --> Building : contains
Building --> BuildingType : defined by

UpgradeAStationUI ..|> Runnable : implements

UpgradeAStationController ..> StationUpgradeService : uses
UpgradeAStationController ..> StationRepository : uses
UpgradeAStationController ..> BuildingRepository : uses

Station ..> StationType : has type

Repositories ..> StationRepository : provides
Repositories ..> BuildingRepository : provides

UpgradeAStationUI ..> UpgradeAStationController : uses

Station --> Map : located on
Map --> Scenario : used in

@enduml
