@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":UpgradeAStationUI" as UI
participant ":UpgradeAStationController" as CTRL
participant ":Repositories" as Repos
participant ":StationRepository" as Station_REPO
participant ":BuildingRepository" as Building_REPO
participant ":Scenario" as Scenario
participant ":StationUpgradeService" as Service
participant ":BuildingTypeMapper" as Mapper

activate Player

Player -> UI : start the simulation
activate UI

UI --> Player : shows a list of the available maps
Player -> UI : selects a map
UI --> Player : shows a list of the available scenarios
Player -> UI : selects a scenario
UI --> Player : shows a list of the actions the player can do
Player -> UI : selects to upgrade a station

UI -> CTRL : create controller
activate CTRL

CTRL -> Repos : getInstance()
activate Repos
Repos --> CTRL : Repositories
deactivate Repos

CTRL -> Repos : getStationRepository()
activate Repos
Repos --> CTRL : StationRepository
deactivate Repos

CTRL -> Station_REPO : getAvailableStations(mapName)
activate Station_REPO
Station_REPO --> CTRL : List<Station>
deactivate Station_REPO

CTRL --> UI : send stations
UI --> Player : show available stations
Player -> UI : selects a station

UI -> CTRL: send selected station
CTRL -> Scenario: getCurrentYear()
activate Scenario

Scenario --> CTRL : currentYear
deactivate Scenario


CTRL -> Repos : getBuildingRepository()
activate Repos
Repos --> CTRL : BuildingRepository
deactivate Repos

CTRL -> Building_REPO : getBuildingTypes()
activate Building_REPO
Building_REPO --> CTRL : List<BuildingType>
deactivate Building_REPO
activate Mapper
CTRL -> Mapper : toDTO(List<BuildingType>)
Mapper --> CTRL : List<BuildingTypeDTO>
deactivate Mapper
CTRL --> UI : send buildingTypesDTO


UI --> Player : show filtered buildings
Player -> UI : selects building type

UI -> CTRL : send selected building type
CTRL -> Building_REPO : getBuildingType()
activate Building_REPO
Building_REPO --> CTRL : BuildingType
deactivate Building_REPO


CTRL -> CTRL : new Building(BuildingType)

CTRL -> Service : upgradeStation(station, Building, currentYear)
activate Service
Service -> Service: checkMutualExclusivity(List<Building> existingBuildings, String newType)
Service -> Service: upgradeStation(Station station, Building building, int currentYear)
Service --> CTRL : success / failure
deactivate Service

alt on success
  CTRL -> Scenario : subtractBudget(Buildingcost)
  activate Scenario
  Scenario --> CTRL : budget updated
  deactivate Scenario
  CTRL --> UI : building added successfully
  UI --> Player : Building added successfully
else on failure
  CTRL --> UI : building not added
    UI --> Player : display a message (Insufficient budget)
end



destroy CTRL
deactivate UI
@enduml