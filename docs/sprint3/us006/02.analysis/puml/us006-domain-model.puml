@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Player {

    - name
    - password
}

class Station {

    - name
    - type
    - buildings
}

class Building {

    - type
}

class BuildingType {
    - name
    - cost
    - effect
    - availableYear
}

class Scenario {
    - id
    - name
    - currentYear
}

class Budget {
    - total
}


Player "1" -- "*" Station : upgrades >
Station "1" -- "*" Building : has >
Building "1" -- "1" BuildingType : type >
Scenario "1" -- "*" Station : contains >
Scenario "1" -- "1" Budget : has >

@enduml
