@startuml "domain-model"

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

hide circle
hide methods

class Authentication {
    - password
    - userType
    + validateUser()
    + authenticate()
}

class Password {
    - value
    - isValid
    + validate()
    + encrypt()
}

class Editor {
    - name
    - password
    + createMap()
    + createScenario()
    + saveMap()
    + loadMap()
}

class Player {
    - name
    - password
    + playSimulation()
    + saveSimulation()
    + loadSimulation()
}

class ProductOwner {
    - name
    - password
    + definePriorities()
    + validateRequirements()
}

class Simulator {
    + startSimulation()
    + pauseSimulation()
    + stopSimulation()
}

class Simulation {
    - currentTime
    - status
    + update()
    + saveState()
    + loadState()
}

class SimulationSave {
    - fileName
    - simulationData
}

class SimulationLoad {
    - fileName
    - simulationData
}

class MapSave {
    - fileName
    - mapData
}

class MapLoad {
    - fileName
    - mapData
}

class ScenarioSave {
    - fileName
    - scenarioData
}

class ScenarioLoad {
    - fileName
    - scenarioData
}

class Map {
    - name
    - width
    - height
}

class City {
    - name
    - mapName
    - centerX
    - centerY
    - blocks
}

class HouseBlock {
    - x
    - y
}

class Industry {
    - name
    - positionX
    - positionY
}

class IndustryType {
    - name
    - description
}

class Scenario {
    - name
    - timeRestrictions
    - technologicalRestrictions
    - historicalRestrictions
    - budget
}

class TimeRestriction {
    - startDate
    - endDate
}

class TechnologicalRestriction {
    - locomotiveTypes
    - industriesAvailable
}

class HistoricalRestriction {
    - historicalEvents
    - goodsImportedExported
}

class Station {
    - stationID
    - stationType
    - positionX
    - positionY
    - orientation
    - buildings
    - economicRadius
    + calculateStatistics()
    + updateCargoDistribution()
}

class StationType {
    - name
}

class Building {
    - buildingType
    - cost
    - effect
    - constructionYear
    + calculateMaintenanceCost()
    + applyEffect()
}

class BuildingType {
    - name
    - cost
    - effect
    - availableYear
}

class Cargo {
    - type
}

class CargoType {
    - passengers
    - mail
    - coal
    - ironOre
    - steel
    - cars
}

class Route {
    - stationsList
}

class RailwayLine {
    - name
    - length
    - type
}

class RailwayLineType {
    - name
}

class Train {
    - name
    - purchaseDate
    - locomotive
    - carriages
    - status
    + calculateMaintenanceCost()
    + updatePosition()
}

class Locomotive {
    - locomotiveModel
    - fuelType
    - speed
    - startYear
    - endYear
    - price
    - fuelCost
    - maintenanceCost
    - route
    - currentFuel
    + calculateFuelConsumption()
    + checkMaintenance()
}

class LocomotiveType {
    - steam
    - diesel
    - electricity
}

class Carriage {
    - name
    - cargoType
}

class YearFinancialResults {
    - expenses
    - revenues
    - year
    + calculateProfit()
    + generateReport()
}

class Expenses {
    - trackMaintenance
    - trainMaintenance
    - fuelCost
    - buildingMaintenance
    + calculateTotal()
}

class Revenues {
    - cargoDeliveries
    - passengerTickets
    - otherIncome
    + calculateTotal()
}

class StationStatistics {
    - averageProfit
    - passengerArrivals
    - cargoDistribution
}

class CargoAnalysis {
    - cargoType
    - revenueCorrelation
    - linearRegression
}

class RouteAnalysis {
    - shortestPath
    - maintenanceRoute
    - algorithmEfficiency
}

Authentication -- Password : validates >
Authentication -- Editor : authenticates >
Authentication -- Player : authenticates >
Authentication -- ProductOwner : authenticates >

Simulator -- Simulation : starts >
Simulator -- Map : uses >
Simulator -- Scenario : uses >

Editor -- Map : creates >
Editor -- Scenario : creates >
Editor -- MapSave : performs >
Editor -- MapLoad : performs >
Editor -- ScenarioSave : performs >
Editor -- ScenarioLoad : performs >

Player -- Simulation : plays >
Player -- SimulationSave : performs >
Player -- SimulationLoad : performs >
Player -- Train : owns >
Player -- Station : manages >
Player -- YearFinancialResults : receives >

Map -- City : contains >
Map -- Industry : contains >
Map -- Station : contains >
Map -- RailwayLine : contains >

City -- HouseBlock : contains >
City -- Cargo : generates >

Industry -- IndustryType : has >
Industry -- Cargo : produces >
Industry -- Cargo : demands >
Industry -- CargoType : handles >

Scenario -- TimeRestriction : has >
Scenario -- TechnologicalRestriction : has >
Scenario -- HistoricalRestriction : has >
Scenario -- Budget : has >
Scenario -- Map : uses >

Station -- StationType : has >
Station -- Building : contains >
Station -- Cargo : handles >
Station -- StationStatistics : generates >
Station -- CargoAnalysis : analyzed by >
Station -- Route : part of >

Building -- BuildingType : has >
Building -- Station : belongs to >

Route -- Station : connects >
Route -- RailwayLine : uses >
Route -- RouteAnalysis : analyzed by >
Route -- Train : assigned to >

Train -- Locomotive : has >
Train -- Carriage : has >
Train -- Route : follows >
Train -- Cargo : transports >

Locomotive -- LocomotiveType : has >
Locomotive -- Cargo : transports >
Locomotive -- Route : follows >

Carriage -- CargoType : carries >
Carriage -- Train : belongs to >

YearFinancialResults -- Expenses : has >
YearFinancialResults -- Revenues : has >
YearFinancialResults -- Player : belongs to >

CargoAnalysis -- CargoType : analyzes >
CargoAnalysis -- Station : analyzes >
RouteAnalysis -- Route : analyzes >
RouteAnalysis -- RailwayLine : considers >

Simulation -- SimulationSave : saves to >
Simulation -- SimulationLoad : loads from >
Map -- MapSave : saves to >
Map -- MapLoad : loads from >
Scenario -- ScenarioSave : saves to >
Scenario -- ScenarioLoad : loads from >

@enduml