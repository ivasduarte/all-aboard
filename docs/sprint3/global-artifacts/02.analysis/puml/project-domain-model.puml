@startuml "domain-model"

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

hide circle
hide methods

class Authentication {
    - password
    - userType
}

class Password {
    - value
    - isValid
}

class Editor {
    - name
    - password
}

class Player {
    - name
    - password
}

class ProductOwner {
    - name
    - password
}

class Simulator {
}

class Simulation {
}

class SimulationSave {
    - fileName
    - simulationData
}

class SimulationLoad {
    - fileName
    - simulationData
}

class MapSave {
    - fileName
    - mapData
}

class MapLoad {
    - fileName
    - mapData
}

class ScenarioSave {
    - fileName
    - scenarioData
}

class ScenarioLoad {
    - fileName
    - scenarioData
}

class Map {
    - name
    - width
    - height
    - cellSizeKm
    - scenarios
    - stations
    - cities
    - industries
}

class City {
    - name
    - mapName
    - centerX
    - centerY
    - blocks
}

class HouseBlock {
    - x
    - y
}

class Industry {
    - name
    - positionX
    - positionY
    - mapID
    - industryType
    - cargoAmount
    - storedIron
    - storedCoal
    - area
}

class IndustryType {
    - name
    - description
}

class Scenario {
    - name
    - timeRestrictions
    - technologicalRestrictions
    - historicalRestrictions
    - budget
    - currentYear
    - finalYear
    - modificationRateFor
    - productionRate
    - trains
}

class TimeRestriction {
    - startDate
    - endDate
}

class TechnologicalRestriction {
    - locomotiveTypes
    - industriesAvailable
}

class HistoricalRestriction {
    - historicalEvents
    - goodsImportedExported
}

class Station {
    - stationID
    - stationType
    - positionX
    - positionY
    - orientation
    - buildings
    - ownerPlayer
    - mapName
    - scenarioName
    - mapID
    - name
    - ironCargo
    - coalCargo
    - steelCargo
    - hasIronStorage
    - hasCoalStorage
    - hasSteelStorage
    - currentCargo
    - maxCargo
    - lastYearDeliveries
    - demand
}

class StationType {
    - name
}

class Building {
    - buildingType
    - cost
    - effect
    - type
}

class BuildingType {
    - name
    - cost
    - effect
    - availableYear
}

class Cargo {
    - type
}

class CargoType {
    - passengers
    - mail
    - coal
    - ironOre
    - steel
    - cars
}

class Route {
    - stationsList
}

class RailwayLine {
    - name
    - length
    - type
}

class RailwayLineType {
    - name
}

class Train {
    - name
    - purchaseDate
    - locomotive
    - carriages
}

class Locomotive {
    - locomotiveModel
    - fuelType
    - speed
    - maxSpeed
    - startYear
    - endYear
    - price
    - fuelCost
    - maintenanceCost
    - route
}

class LocomotiveType {
    - steam
    - diesel
    - electricity
}

class Carriage {
    - name
    - cargoType
    - cargo
    - maxCargo
    - currentCargo
}

class YearFinancialResults {
    - expenses
    - revenues
}

class Expenses {
    - trackMaintenance
    - trainMaintenance
    - fuelCost
}

class Revenues {
    - cargoDeliveries
}

class StationStatistics {
    - averageProfit
    - passengerArrivals
    - cargoDistribution
}

class Budget {
    - budget
}

class Date {
    - year
    - month
    - day
}

enum CargoMode {
    FULL
    HALF
    AVAILABLE
}

Authentication -- Password : validates >
Authentication -- Editor : authenticates >
Authentication -- Player : authenticates >
Authentication -- ProductOwner : authenticates >

Simulator -- Simulation : starts >
Simulation -- Player: creates >
Simulation -- Editor: creates >
Simulation -- SimulationSave : saves >
Simulation -- SimulationLoad : loads >

Map *-- "0..*" City : contains >
Map *-- "0..*" Industry : contains >
Map *-- "0..*" Station : contains >
Map *-- "0..*" Scenario : contains >
Map -- MapSave : saves >
Map -- MapLoad : loads >

City *-- "0..*" HouseBlock : contains >
City -- "0..*" Cargo : generates/consumes >

Industry "*" -- "1" IndustryType : has >
Industry -- "0..*" Cargo : generates/processes >

Scenario -- Map : is created for >
Scenario "1" -- "1" TimeRestriction : has >
Scenario "1" -- "1" TechnologicalRestriction : has >
Scenario "1" -- "1" HistoricalRestriction : has >
Scenario -- Budget : has >
Scenario -- Train : manages >
Scenario -- ScenarioSave : saves >
Scenario -- ScenarioLoad : loads >

Station o-- "0..*" Building : has >
Station "*" - "1" StationType : has >
Station -- StationStatistics : analyzes >
Station -- CargoAnalysis : analyzes >
Building "*" -- "1" BuildingType : has >

RailwayLine -- "2" Station : connects >
RailwayLine "*" - "1" RailwayLineType : has >
Route *-- "2..*" Station : includes >

Player -- Station : builds >
Player -- RailwayLine : builds >
Player -- Train : buys >
Player "1" -- "*" YearFinancialResults : gets >

YearFinancialResults -- Expenses : has >
YearFinancialResults -- Revenues : has >

Train *-- "1" Locomotive : has >
Train *-- "0..*" Carriage : has >
Train -- Route : assigned to >
Locomotive "*" -- "1" LocomotiveType : has >

Carriage "1" - "*" CargoType : has >
Carriage -- Cargo : carries >
Cargo "*" - "1" CargoType : has >
Cargo -- CargoMode : has >

Editor -- Map : creates >
Editor -- Scenario : creates >

TimeRestriction -- Date : uses >

@enduml