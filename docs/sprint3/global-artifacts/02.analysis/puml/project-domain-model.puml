@startuml "domain-model"

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

hide circle
hide methods

class Authentication {
    - password
    - userType
}

class Password {
    - value
    - isValid
}

class Editor {
    - name
    - password
}

class Player {
    - name
    - password
}

class ProductOwner {
    - name
    - password
}

class Simulator {
}

class Simulation {
}

class SimulationSave {
    - fileName
    - simulationData
}

class SimulationLoad {
    - fileName
    - simulationData
}

class MapSave {
    - fileName
    - mapData
}

class MapLoad {
    - fileName
    - mapData
}

class ScenarioSave {
    - fileName
    - scenarioData
}

class ScenarioLoad {
    - fileName
    - scenarioData
}

class Map {
    - name
    - width
    - height
}

class City {
    - name
    - mapName
    - centerX
    - centerY
    - blocks
}

class HouseBlock {
    - x
    - y
}

class Industry {
    - name
    - positionX
    - positionY
}

class IndustryType {
    - name
    - id
    - description
}

class Scenario {
    - name
    - timeRestrictions
    - technologicalRestrictions
    - historicalRestrictions
    - budget
}

class TimeRestriction {
    - startDate
    - endDate
}

class TechnologicalRestriction {
    - locomotiveTypes
    - industriesAvailable
}

class HistoricalRestriction {
    - historicalEvents
    - goodsImportedExported
}

class Station {
    - stationID
    - stationType
    - positionX
    - positionY
    - orientation
    - buildings
}

class StationType {
    - name
}

class Building {
    - buildingType
    - cost
    - effect
}

class BuildingType {
    - name
    - cost
    - effect
    - availableYear
}

class Cargo {
    - type
}

class CargoType {
    - passengers
    - mail
    - coal
    - ironOre
    - steel
    - cars
}

class Route {
    - stationsList
}

class RailwayLine {
    - name
    - length
    - type
}

class RailwayLineType {
    - name
}

class Train {
    - name
    - purchaseDate
    - locomotive
    - carriages
}

class Locomotive {
    - locomotiveModel
    - fuelType
    - speed
    - startYear
    - endYear
    - price
    - fuelCost
    - maintenanceCost
    - route
}

class LocomotiveType {
    - steam
    - diesel
    - electricity
}

class Carriage {
    - name
    - cargoType
}

class YearFinancialResults {
    - expenses
    - revenues
}

class Expenses {
    - trackMaintenance
    - trainMaintenance
    - fuelCost
}

class Revenues {
    - cargoDeliveries
}

class StationStatistics {
    - averageProfit
    - passengerArrivals
    - cargoDistribution
}

class CargoAnalysis {
    - cargoType
    - revenueCorrelation
    - linearRegression
}

class RouteAnalysis {
    - shortestPath
    - maintenanceRoute
    - algorithmEfficiency
}

Authentication -- Password : validates >
Authentication -- Editor : authenticates >
Authentication -- Player : authenticates >
Authentication -- ProductOwner : authenticates >

Simulator -- Simulation : starts >

Editor -- Map : creates >
Editor -- Scenario : creates >
Map *-- "0..*" City : contains >
Map *-- "0..*" Industry : contains >
Scenario -- Map : is created for >

City *-- "0..*" HouseBlock : contains >

Station o-- "0..*" Building : has >
Building "*" -- "1" BuildingType : has >

RailwayLine -- "2" Station : connects >

Player -- Station : builds >
Player -- RailwayLine : builds >
Player -- Train : buys >
Player "1" -- "*" YearFinancialResults : gets >

YearFinancialResults -- Expenses : has >
YearFinancialResults -- Revenues : has >

Simulation -- Player: creates >
Simulation -- Editor: creates >

Train *-- "1" Locomotive : has >
Locomotive "*" -- "1" LocomotiveType : has >
Carriage "1" - "*" CargoType : has >
Train *-- "0..*" Carriage : has >
Train -- Route : assigned to >
Route *-- "2..*" Station : includes >

City -- "0..*" Cargo : generates/consumes >
Industry -- "0..*" Cargo : generates/processes >

Cargo "*" - "1" CargoType : has >

Scenario "1" -- "1" TimeRestriction : has >
Scenario "1" -- "1" TechnologicalRestriction : has >
Scenario "1" -- "1" HistoricalRestriction : has >

Industry "*" -- "1" IndustryType : has >
Station "*" - "1" StationType : has >
RailwayLine "*" - "1" RailwayLineType : has >

Simulation -- SimulationSave : saves >
Simulation -- SimulationLoad : loads >
Map -- MapSave : saves >
Map -- MapLoad : loads >
Scenario -- ScenarioSave : saves >
Scenario -- ScenarioLoad : loads >

Station -- StationStatistics : analyzes >
Station -- CargoAnalysis : analyzes >
Route -- RouteAnalysis : analyzes >

@enduml