@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":CreateCityUI" as UI
participant ":CreateCityController" as CTRL
participant ":Repositories" as reps
participant "repositories\n:Repositories" as PLAT
participant "mapRepo\n:MapRepository" as mapRepo
participant "cityRepo\n:CityRepository" as cityRepo
participant ":MapMapper" as mapper
participant ":MapDTO" as dto
participant ":City" as City
participant ":HouseBlock" as HouseBlock

activate Editor

Editor -> UI : requests to create a new city

activate UI
UI -> CTRL** : create

'Editor -> UI : provides map name, city name, and coordinates
'UI -> CTRL : validateNameMap(name, map)

activate CTRL

CTRL -> reps : getInstance()
activate reps
reps --> CTRL : repositories
deactivate reps

CTRL -> PLAT : getMapRepository()
activate PLAT
PLAT --> CTRL : mapRepository
deactivate PLAT

CTRL -> PLAT : getCityRepository()
activate PLAT
PLAT --> CTRL : cityRepository
deactivate PLAT

UI -> CTRL: getMapList()
CTRL -> mapRepo: getMapList()
activate mapRepo
mapRepo --> CTRL: list of maps
deactivate mapRepo

CTRL -> mapper: getMapListDTO(mapList)
activate mapper
loop for each map in mapList
                        mapper --> dto : MapDTO = toDTO(mapList)
                            activate dto
                            deactivate dto
                    end loop
    mapper --> CTRL: mapDTOList
    deactivate mapper
   CTRL --> UI: mapDTOList
    deactivate CTRL
UI --> Editor: shows list of maps\n for user to select
Editor -> UI: selects a map
UI --> Editor: requests data to add city\n(name, x,y)
Editor -> UI: inputs data needed to add city


UI -> CTRL : createCity(name, map, x, y)
activate CTRL
'this will do the conversion dto -> object
CTRL -> mapRepo : getMap(mapDTO)

activate mapRepo
mapRepo --> CTRL : map
deactivate mapRepo




CTRL -> City** : create(name, map, x, y)



loop for each block to add
  CTRL -> HouseBlock** : createBlock(x, y)
  CTRL -> cityRepo : isBlockPositionUnique(map, block)
  activate cityRepo
  cityRepo --> CTRL : isUnique
  deactivate cityRepo
  CTRL -> City : addBlockManual(block, map)
  activate City
  deactivate City
end

CTRL -> cityRepo : addAndVerify(city)
activate cityRepo
CTRL --> UI : success
deactivate cityRepo
deactivate CTRL

UI --> Editor : display result
deactivate UI
deactivate Editor

@enduml