@startuml
skinparam classAttributeIconSize 0

interface Runnable {
    +run(): void
}

class ApplicationSession {
    -instance: ApplicationSession{static}
    -userSession: UserSession
    +getInstance(): ApplicationSession{static}
    +getCurrentSession(): UserSession
    +setUserSession(): void
}

class UserSession {
    -instance: UserSession{static}
    -user: UserSession
    +getInstance(): UserSession{static}
}

class Editor {
    -name: String
    -ID: String
    -password: String
    +getEditorName(): String
    +getEditorID(): String
    +getEditorPassword(): String
}

class City {
    -name: String
    -mapName: String
    -centerX: int
    -centerY: int
    -blocks: List<HouseBlock>
    +City(name, mapName, centerX, centerY)
    +getName(): String
    +getMapName(): String
    +getCenterX(): int
    +getCenterY(): int
    +getBlocks(): List<HouseBlock>
    +addBlockManual(block: HouseBlock): void
    +clearBlocks(): void
}

class HouseBlock {
    -x: int
    -y: int
    +HouseBlock(x, y)
    +getX(): int
    +getY(): int
    +equals(obj: Object): boolean
    +hashCode(): int
}

class CityRepository {
    -cities: List<City>
    +add(city: City): void
    +getCities(): List<City>
    +isNameUnique(name: String, map: String): boolean
    +existsAtPosition(map: String, x: int, y: int): boolean
    +isBlockPositionUnique(map: String, block: HouseBlock): boolean
}

class MapRepository {
    +getMap(name: String): Optional<Map>
}

class Repositories {
    -instance: Repositories{static}
    -cityRepository: CityRepository
    -mapRepository: MapRepository
    +getInstance(): Repositories{static}
    +getCityRepository(): CityRepository
    +getMapRepository(): MapRepository
}

enum NameMapError {
    NONE
    INVALID_NAME
    NAME_EXISTS
    MAP_NOT_FOUND
}

enum CenterError {
    NONE
    POSITION_OCCUPIED
    OUTSIDE_MAP
}

enum BlockError {
    NONE
    POSITION_OCCUPIED
    OUTSIDE_MAP
}

class CreateCityController {
    -mapRepo: MapRepository
    -cityRepo: CityRepository
    +validateNameMap(name: String, map: String): NameMapError
    +validateCenter(name: String, map: String, x: int, y: int): CenterError
    +validateBlock(map: String, block: HouseBlock): BlockError
    +createCity(name: String, map: String, x: int, y: int): City
    +addBlockManual(city: City, block: HouseBlock): boolean
    +assignBlocksAuto(city: City, count: int, sigma: double): void
}

class AddCityUI {
    -controller: CreateCityController
    -scanner: Scanner
    -cityName: String
    -mapName: String
    -centerX: int
    -centerY: int
    +run(): void
    +getInput(): void
}

class MapDTO{
    -name: String
    -width: int
    -height: int
}

class MapMapper{
    + getMapDTOList(mapList: List<Map>)
    + toDTO(map: Map)
}

Repositories -> Repositories : instance
ApplicationSession -> ApplicationSession : instance

AddCityUI ..> CreateCityController
CreateCityController ..> City : creates
CreateCityController ..> HouseBlock : validates
CreateCityController ..> CityRepository : uses
CreateCityController ..> MapRepository : uses
CreateCityController ..> NameMapError
CreateCityController ..> CenterError
CreateCityController ..> BlockError

CreateCityController "1" --> "1" MapMapper
MapMapper --> MapDTO: creates

AddCityUI ..|> Runnable

Repositories --> "1" CityRepository
Repositories --> "1" MapRepository

ApplicationSession --> "1" UserSession : userSession

CreateCityController ..> ApplicationSession
CreateCityController ..> UserSession

City "1" *-- "*" HouseBlock : contains
CityRepository "1" --> "*" City : manages

City --> Map : exists on
City --> Editor: created by

@enduml