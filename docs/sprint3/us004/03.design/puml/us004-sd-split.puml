@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor

participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as CTRL
participant ":DisplayMapController" as mapCTRL
participant ":MapMapper" as mapper
participant ":MapDTO" as dto
participant ":Restrictions" as Restrictions
participant ":Scenario" as Scenario
participant ":Budget" as Budget
participant ":Map" as Map

activate Editor
Editor -> UI : requests to create a scenario

activate UI
UI -> CTRL** : create()

activate CTRL

    ref over CTRL
        Get Repositories
    end ref

autonumber 9
UI -> CTRL : getMapList()

CTRL -> mapCTRL : getMapList()
activate mapCTRL

    ref over mapCTRL
        Get Map List
    end ref

autonumber 16
mapCTRL --> CTRL : mapDTOList
deactivate mapCTRL
CTRL --> UI : mapDTOList
deactivate CTRL

UI -> Editor : requests to select map from list
deactivate UI
Editor -> UI : selects map from list
activate UI

UI -> Editor : request scenario data
deactivate UI
Editor -> UI : provides scenario data\n(name, dates, loco types, events)
activate UI

UI -> CTRL : restrictions
activate CTRL
CTRL -> Restrictions : new Restrictions(startDate, endDate, locoTypes, events)
activate Restrictions
Restrictions --> CTRL : restrictions
deactivate Restrictions

CTRL -> Restrictions : validate()
activate Restrictions
Restrictions -> Restrictions : validateTimeRestrictions()
Restrictions -> Restrictions : validateLocomotiveTypes()
Restrictions -> Restrictions : validateHistoricalRestrictions()
Restrictions --> CTRL : validation result
deactivate Restrictions

CTRL --> UI : validation result
deactivate CTRL

alt restrictions not valid
    UI -> Editor : showError("Invalid restrictions provided")
    Editor --> UI : provides new restrictions
end

UI -> CTRL : createScenario(scenarioName, restrictions)
activate CTRL

    ref over CTRL
        Get Map
    end ref

autonumber 36
CTRL -> Budget : new Budget()
activate Budget
Budget --> CTRL : defaultBudget
deactivate Budget

CTRL -> Scenario : create(scenarioName, restrictions, map, defaultBudget)
activate Scenario
Scenario -> Scenario : validateName()
alt name not valid
    Scenario --> CTRL : throw IllegalArgumentException
    deactivate Scenario
    CTRL --> UI : "ERROR: " + e.getMessage()
    deactivate CTRL
    UI -> Editor : showError(result)
    Editor --> UI : provides new name

else name is valid

    activate Scenario
    activate CTRL
    Scenario --> CTRL : scenario
    deactivate Scenario

    ref over CTRL
        Add Scenario
    end ref

    autonumber 50
    CTRL --> UI : "Scenario '" + scenarioName + "' created successfully."
    deactivate CTRL

    UI --> Editor : showSuccess(result)
    deactivate UI
end

deactivate Editor
@enduml