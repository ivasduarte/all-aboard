@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
actor "Editor" as Editor
participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as CTRL
participant ":Repositories" as reps
participant "repositories\n:Repositories" as PLAT
participant ":DisplayMapController" as mapCTRL
participant "mapRepository\n:MapRepository" as mapRep
participant ":MapMapper" as mapper
participant ":MapDTO" as dto
participant ":Restrictions" as Restrictions
participant ":Scenario" as Scenario
participant "scenarioRepository\n:ScenarioRepository" as Repo
participant ":Budget" as Budget
participant ":Map" as Map

activate Editor
Editor -> UI : requests to create a scenario
activate UI

UI -> CTRL** : create()
activate CTRL

CTRL -> reps : getInstance()
activate reps
reps --> CTRL : instance
deactivate reps

CTRL -> PLAT : getMapRepository()
activate PLAT
PLAT --> CTRL : mapRepository
deactivate PLAT

CTRL -> PLAT : getScenarioRepository()
activate PLAT
PLAT --> CTRL : scenarioRepository
deactivate PLAT

UI -> CTRL : getMapList()

CTRL -> mapCTRL : getMapList()
autonumber 3.1
activate mapCTRL
mapCTRL -> mapRep : getMapList()
activate mapRep
mapRep --> mapCTRL : mapList
deactivate mapRep

mapCTRL -> mapper : getMapListDTO(mapList)
activate mapper
loop for each map in list
    mapper --> dto : MapDTO = toDTO(map)
    activate dto
    deactivate dto
end
mapper --> mapCTRL : mapDTOList
deactivate mapper

mapCTRL --> CTRL : mapDTOList
deactivate mapCTRL
CTRL --> UI : mapDTOList
deactivate CTRL

autonumber 4
UI -> Editor : requests to select map from list
deactivate UI
Editor -> UI : selects map from list
activate UI

UI -> Editor : request scenario data
deactivate UI
Editor -> UI : provides scenario data\n(name, dates, loco types, events)
activate UI

UI -> CTRL : restrictions
activate CTRL
CTRL -> Restrictions : new Restrictions(startDate, endDate, locoTypes, events)
activate Restrictions
Restrictions --> CTRL : restrictions
deactivate Restrictions

CTRL -> Restrictions : validate()
activate Restrictions
Restrictions -> Restrictions : validateTimeRestrictions()
Restrictions -> Restrictions : validateLocomotiveTypes()
Restrictions -> Restrictions : validateHistoricalRestrictions()
Restrictions --> CTRL : validation result
deactivate Restrictions

CTRL --> UI : validation result
deactivate CTRL

alt restrictions not valid
    UI -> Editor : showError("Invalid restrictions provided")
    Editor --> UI : provides new restrictions
end

UI -> CTRL : createScenario(scenarioName, restrictions)
activate CTRL

CTRL -> mapRep : getMap(mapDTO)
activate mapRep
mapRep --> CTRL : map
deactivate mapRep

CTRL -> Budget : new Budget()
activate Budget
Budget --> CTRL : defaultBudget
deactivate Budget

CTRL -> Scenario : create(scenarioName, restrictions, map, defaultBudget)
activate Scenario
Scenario -> Scenario : validateName()
alt name not valid
    Scenario --> CTRL : throw IllegalArgumentException
    deactivate Scenario
    CTRL --> UI : "ERROR: " + e.getMessage()
    deactivate CTRL
    UI -> Editor : showError(result)
    Editor --> UI : provides new name

else name is valid

    activate Scenario
    activate CTRL
    Scenario --> CTRL : scenario
    deactivate Scenario

    CTRL -> Repo : add(scenario)
    activate Repo
    Repo -> Repo : validateScenario(scenario)
    Repo --> CTRL : scenario
    deactivate Repo

    CTRL -> Map : addNewScenario(scenario)
    activate Map
    Map --> CTRL : new scenario
    deactivate Map

    CTRL --> UI : "Scenario '" + scenarioName + "' created successfully."
    deactivate CTRL

    UI --> Editor : showSuccess(result)
    deactivate UI
end

deactivate Editor
@enduml
