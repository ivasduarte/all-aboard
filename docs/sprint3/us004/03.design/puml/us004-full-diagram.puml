@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
actor "Editor" as Editor
participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as CTRL
participant ":DisplayMapController" as mapCTRL
participant ":Repositories" as reps
participant "repositories\n:Repositories" as PLAT
participant "mapRepository\n:MapRepository" as mapRep
participant "scenarioRepository\n:ScenarioRepository" as Repo
participant ":Scenario" as Scenario
participant ":Restrictions" as Restrictions
participant ":Budget" as Budget
participant ":Map" as Map

activate Editor

Editor -> UI : requests to create a scenario
activate UI

UI -> CTRL** : create()

UI -> mapCTRL : getMapList()
autonumber 3.1
activate mapCTRL
mapCTRL -> reps : getInstance()
activate reps
reps --> mapCTRL : instance
deactivate reps
mapCTRL -> PLAT : getMapRepository()
activate PLAT
PLAT --> mapCTRL : mapRep
deactivate PLAT
mapCTRL -> mapRep : getMapList()
activate mapRep
mapRep --> mapCTRL : List<Map>
deactivate mapRep
mapCTRL --> UI : List<Map>
deactivate mapCTRL

autonumber 4
UI -> Editor : requests to select map from list
deactivate UI
Editor --> UI : selects map from list
activate UI

UI -> Editor : request scenario data
deactivate UI
Editor --> UI : provides scenario data (name, dates, locomotive types, historical events)
activate UI

UI -> Restrictions** : new Restrictions(startDate, endDate, locoTypes, events)
activate Restrictions
Restrictions --> UI : restrictions
deactivate Restrictions

UI -> Restrictions : validate()
activate Restrictions
Restrictions -> Restrictions : validateTimeRestrictions()
Restrictions -> Restrictions : validateLocomotiveTypes()
Restrictions -> Restrictions : validateHistoricalRestrictions()
Restrictions --> UI : validation result
deactivate Restrictions

alt restrictions not valid
    UI -> Editor : showError("Invalid restrictions provided")
    Editor --> UI : provides new restrictions
end

UI -> CTRL : createScenario(scenarioName, restrictions, map)
activate CTRL

autonumber 6.1
CTRL -> reps : getInstance()
activate reps
reps --> CTRL : repositories
deactivate reps

CTRL -> PLAT : getScenarioRepository()
activate PLAT
PLAT --> CTRL : scenarioRepository
deactivate PLAT

CTRL -> Map : getScenarios()
activate Map
Map --> CTRL : List<Scenario>
deactivate Map

loop for each scenario in scenarios
    CTRL -> Scenario : getScenarioName()
    activate Scenario
    Scenario --> CTRL : name
    deactivate Scenario

    alt name already exists
        CTRL --> UI : "ERROR: A scenario with this name already exists."
        deactivate CTRL
        UI -> Editor : showError(result)
        Editor --> UI : provides new name
        UI -> CTRL : createScenario(newName, restrictions, map)
        activate CTRL
    end
end

CTRL -> Budget** : new Budget(1000)
activate Budget
Budget --> CTRL : defaultBudget
deactivate Budget

CTRL -> Scenario** : new Scenario(name, restrictions, map, defaultBudget)
activate Scenario
Scenario -> Scenario : validateName()

alt name not valid
    Scenario --> CTRL : throw IllegalArgumentException
    deactivate Scenario
    CTRL --> UI : "ERROR: " + e.getMessage()
    deactivate CTRL
    UI -> Editor : showError(result)
    Editor --> UI : provides new name
    UI -> CTRL : createScenario(newName, restrictions, map)
    activate CTRL
    CTRL -> Scenario** : new Scenario(newName, restrictions, map, defaultBudget)
    activate Scenario
end

Scenario --> CTRL : scenario
deactivate Scenario

CTRL -> Repo : add(scenario)
activate Repo
Repo -> Repo : validateScenario(scenario)
Repo --> CTRL : void
deactivate Repo

CTRL -> Map : addNewScenario(scenario)
activate Map
Map --> CTRL : void
deactivate Map

CTRL --> UI : "Scenario '" + name + "' created successfully."
deactivate CTRL

UI --> Editor : showSuccess(result)
deactivate UI
deactivate Editor

@enduml