@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Editor {
  - name
  - password
}

class Scenario {
  - name: String
  - restrictions: Restrictions
  - map: Map
  - budget: Budget
  - currentYear: int
  - finalYear: int
  - modificationRateFor: double
  - productionRate: double
  - trains: List<Train>
}

class Map {
  - name
  - width: int
  - height: int
}

class Restrictions {
  - startDate
  - endDate
  - locomotiveTypes
  - industriesAvailable
  - historicalEvents
  - goodsImportedExported
}

class Budget {
  - budget: int
}

class Train {
  - name
  - type
  - capacity
}

Scenario "1" -- "1" Map : is created for
Scenario "1" -- "1" Restrictions : has
Scenario "1" -- "1" Budget : has
Scenario "1" -- "*" Train : contains
Editor "1" -- "*" Scenario : can create

@enduml
@enduml