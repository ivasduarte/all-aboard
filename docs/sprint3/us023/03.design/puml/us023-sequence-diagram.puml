@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as player

participant ":SaveSimulationUI" as ui

activate player
player -> ui : Requests to save a simulation

create ":SaveSimulationController" as ctrl

activate ui
ui -> ctrl : create()

participant ":ApplicationSession" as app
participant ":UserSession" as user

ui -> ctrl : saveSimulation()
activate ctrl

ctrl -> app : getCurrentSession()
activate app

app --> ctrl : userSession
deactivate app

ctrl -> user : getUser()
activate user

user --> ctrl : currentUser
deactivate user

participant ":Repositories" as reps
participant "repositories\n:Repositories" as repo
participant "simulationRepository\n:SimulationRepository" as simRepo

ctrl -> reps : getInstance()
activate reps

reps --> ctrl : instance
deactivate reps

ctrl -> repo : getSimulationRepository()
activate repo

repo --> ctrl : simulationRepository
deactivate repo

ctrl -> simRepo : getCurrentSimulation(currentUser)
activate simRepo

simRepo --> ctrl : currentSimulation
deactivate simRepo

ctrl -> simRepo : saveSimulation(currentSimulation)
activate simRepo

simRepo --> ctrl : saved simulation data
deactivate simRepo

ctrl --> ui : saved simulation data
deactivate ctrl

ui --> player : shows success message on saving simulation
deactivate ui

@enduml